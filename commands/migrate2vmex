COMPLETION_FILE="/usr/share/bash-completion/completions/$PROG"
COMPLETION_FILE_OLD="/etc/bash_completion.d/$PROG"   # where earlier copies were put by hand
completion_script() {
  cat <<'COMPLETION_EOF'
# bash completion for migrate2vmex - installed by: migrate2vmex -installautocomplete

# VM names from the ESXi host given with -sourcehost (SSH key login, cached for 5 minutes)
_migrate2vmex_vms() {
  local host=$1 user=${2:-root} port=${3:-22} key=$4 cache now
  [[ -n $host ]] || return 0
  if [[ -z $key ]]; then
    for key in /root/.ssh/migrate2vmex_rsa /root/.ssh/esxi2kvm_rsa ~/.ssh/migrate2vmex_rsa; do [[ -r $key ]] && break; done
  fi
  [[ -r $key ]] || return 0
  cache="${TMPDIR:-/tmp}/.migrate2vmex-vms-$UID-$host"
  now=$(date +%s)
  if [[ ! -s $cache ]] || (( now - $(stat -c %Y "$cache" 2>/dev/null || echo 0) > 300 )); then
    timeout 8 ssh -n -i "$key" -p "$port" -o BatchMode=yes -o ConnectTimeout=4 \
        -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR "$user@$host" \
        'vim-cmd vmsvc/getallvms 2>/dev/null' 2>/dev/null \
      | awk 'NR > 1 && $1 ~ /^[0-9]+$/ { line = $0; sub(/^[0-9]+[ \t]+/, "", line); sub(/[ \t]+\[.*$/, "", line); print line; print $1 }' \
      >"$cache.$$" 2>/dev/null && mv -f "$cache.$$" "$cache" 2>/dev/null
    rm -f "$cache.$$" 2>/dev/null
  fi
  [[ -s $cache ]] && cat "$cache"
}

_migrate2vmex() {
  local cur prev words cword
  if declare -F _init_completion >/dev/null; then
    _init_completion -n = || return
  else
    cur=${COMP_WORDS[COMP_CWORD]}; prev=${COMP_WORDS[COMP_CWORD-1]}; words=("${COMP_WORDS[@]}"); cword=$COMP_CWORD
  fi

  local opts="-interactive -setup -list -vm -all
    -sourcehost -user -port -key
    -method -no-fallback -pool -target-dir -format -min-free -skip-space-check
    -target-name -v2v-arg -virtio-win -keep-virtio -force-in-transit
    -stream-libdir -stream-thumbprint -stream-transports -stream-config -stream-tarball -stream-url -esxi-password-file
    -san-portal -san-target -san-cleanup
    -network -bridge -net-map -no-keep-mac
    -shutdown -force-off -shutdown-timeout -consolidate -warm -cutover -repair-unclean
    -skip-rdm -no-compress -verify -start -autostart -dry-run -yes
    -log-dir -debug -ignore-os -help"

  # host/user/port/key already on the command line (for --vm lookups)
  # options are written with one dash (-pool); two dashes are accepted too
  _m2v_opt() { if [[ $1 == -[A-Za-z]?* && $1 != --* ]]; then printf -- '-%s' "$1"; else printf '%s' "$1"; fi; }
  local i host="" user="" port="" key=""
  for ((i = 1; i < cword; i++)); do
    case $(_m2v_opt "${words[i]}") in
      -sourcehost|--sourcehost|-H|--host) host=${words[i+1]} ;;
      -u|--user) user=${words[i+1]} ;;
      -p|--port) port=${words[i+1]} ;;
      -k|--key)  key=${words[i+1]} ;;
    esac
  done

  case $(_m2v_opt "$prev") in
    --method)            COMPREPLY=($(compgen -W "auto copy stream vmfs v2v raw" -- "$cur")); return ;;
    --format)            COMPREPLY=($(compgen -W "qcow2 raw" -- "$cur")); return ;;
    --cutover)           COMPREPLY=($(compgen -W "ask auto" -- "$cur")); return ;;
    --stream-transports|--vddk-transports) COMPREPLY=($(compgen -W "nbd nbdssl nbd:nbdssl" -- "$cur")); return ;;
    --pool)
      COMPREPLY=($(compgen -W "$(virsh -q pool-list --all --name 2>/dev/null)" -- "$cur")); return ;;
    --network)
      COMPREPLY=($(compgen -W "$(virsh -q net-list --all --name 2>/dev/null)" -- "$cur")); return ;;
    --bridge)
      local b brs=""
      for b in /sys/class/net/*/bridge; do [[ -e $b ]] && brs+=" $(basename "${b%/bridge}")"; done
      COMPREPLY=($(compgen -W "$brs" -- "$cur")); return ;;
    -sourcehost|--sourcehost|-H|--host|--san-portal)
      local hs
      hs=$(awk '{ split($1, a, ","); for (i in a) { h = a[i]; sub(/^\[/, "", h); sub(/\]:.*$/, "", h); if (h !~ /^\|/) print h } }' \
             ~/.ssh/known_hosts /root/.ssh/known_hosts 2>/dev/null | sort -u)
      COMPREPLY=($(compgen -W "$hs" -- "$cur")); return ;;
    -u|--user)           COMPREPLY=($(compgen -W "root" -- "$cur")); return ;;
    -p|--port)           COMPREPLY=($(compgen -W "22" -- "$cur")); return ;;
    --vm)
      local n c=${cur//\\/}; c=${c#[\"\']}
      while IFS= read -r n; do
        [[ -n $n && $n == "$c"* ]] && COMPREPLY+=("$(printf '%q' "$n")")
      done < <(_migrate2vmex_vms "$host" "$user" "$port" "$key")
      return ;;
    --stream-tarball|--vddk-tarball)
      COMPREPLY=($(compgen -f -X '!*.tar.gz' -- "$cur") $(compgen -d -- "$cur")); compopt -o filenames 2>/dev/null; return ;;
    -k|--key|--stream-config|--vddk-config|--esxi-password-file|--virtio-win)
      COMPREPLY=($(compgen -f -- "$cur")); compopt -o filenames 2>/dev/null; return ;;
    --target-dir|--stream-libdir|--vddk-libdir|--log-dir)
      COMPREPLY=($(compgen -d -- "$cur")); compopt -o filenames 2>/dev/null; return ;;
    --stream-url|--vddk-url|--min-free|--shutdown-timeout|--target-name|--v2v-arg|--stream-thumbprint|--vddk-thumbprint|--san-target|--net-map)
      return ;;   # free text
  esac

  if [[ $cur == --* ]]; then   # two dashes typed: offer the same options with two dashes
    COMPREPLY=($(compgen -W "$(printf -- '-%s ' $opts)" -- "$cur"))
  else
    COMPREPLY=($(compgen -W "$opts" -- "$cur"))
  fi
}

complete -F _migrate2vmex migrate2vmex
complete -F _migrate2vmex ./migrate2vmex 2>/dev/null || true
COMPLETION_EOF
}

completion_installed() { [[ -s $COMPLETION_FILE ]] && grep -q '_migrate2vmex' "$COMPLETION_FILE" 2>/dev/null; }

install_autocomplete() {
  [[ $EUID -eq 0 ]] || { echo "Run as root: $PROG -installautocomplete" >&2; exit 1; }
  if ! rpm -q bash-completion >/dev/null 2>&1; then
    echo "Installing bash-completion ..."
    dnf -y -q install bash-completion >/dev/null 2>&1 || { echo "Could not install the bash-completion package (dnf install bash-completion)" >&2; exit 1; }
  fi
  mkdir -p "${COMPLETION_FILE%/*}"
  completion_script >"$COMPLETION_FILE.tmp" && chmod 644 "$COMPLETION_FILE.tmp" && mv -f "$COMPLETION_FILE.tmp" "$COMPLETION_FILE" \
    || { rm -f "$COMPLETION_FILE.tmp"; echo "Could not write $COMPLETION_FILE" >&2; exit 1; }
  have restorecon && restorecon "$COMPLETION_FILE" 2>/dev/null || true
  if [[ -e $COMPLETION_FILE_OLD ]]; then   # an older copy there would be loaded instead of this one
    rm -f -- "$COMPLETION_FILE_OLD" && echo "Removed the older copy $COMPLETION_FILE_OLD"
  fi
  echo "Tab completion for $PROG installed: $COMPLETION_FILE"
  echo "New shells load it automatically. To load it in this shell, run:"
  echo
  echo "  source $COMPLETION_FILE"
  echo
}

usage() {
  local ac=""
  completion_installed || ac=$'\n  -installautocomplete     Install Tab completion for this command (once, as root)'
  cat <<EOF
$PROG $VERSION ($PRODUCT_LABEL) - migrate VMs from VMware ESXi to VMeX

Usage: $PROG -sourcehost ESXI-HOST [options] [ACTION]

Actions:
  -i, -interactive         Choose VMs, storage, network etc. from menus
                           (default when only -sourcehost is given)
  -setup                   Install packages, create SSH key, install it on ESXi
  -list                    List VMs on the ESXi host
  -vm NAME|VMID            Migrate a VM (repeatable)
  -all                     Migrate every VM on the host

Connection:
  -sourcehost HOST         ESXi host to migrate from: hostname or IP (required)
  -u, -user USER           ESXi user (default: root)
  -p, -port PORT           SSH port (default: 22)
  -k, -key FILE            SSH private key (default: $SSH_KEY)

Conversion:
  -method auto|stream|vmfs|v2v|copy|raw
                           stream = In-Transit Disk Streaming: fast, converted in
                                  transit, only used blocks (licensed ESXi 6.7+)
                           vmfs = read the VM straight from the ESXi SAN, read-only
                                  (fastest; Fedora must reach the iSCSI storage)
                           copy = disk copy over SSH, then convert in place
                                  (recommended: proven to produce bootable VMs)
                           v2v  = V2V over SSH, converted in transit (slow on
                                  old ESXi; Windows 2012 R2 and older use the copy)
                           auto = copy for Linux/Windows, raw for other OSes (default)
  -no-fallback             Do not fall back to the next method on failure
  -pool NAME               libvirt storage pool (must exist; default: the first pool)
  -target-dir DIR          Store disks in DIR (a storage pool is created for it)
  -format qcow2|raw        Target disk format (default: qcow2 -> <pool>/<VM>/<VM>.qcow2;
                           raw -> <VM>.img). The SSH copy streams straight into qcow2.
  -min-free GB             Space always kept free in the pool (default: 5% of the
                           pool, at least 10 and at most 100 GiB)
  -skip-space-check        Migrate even if the space estimate says it does not fit
  -target-name NAME        Name of the new domain (single VM only)
  -v2v-arg ARG             Extra argument passed to V2V (repeatable)
  -virtio-win PATH         virtio-win ISO or directory (default: $VIRTIO_WIN_DIR).
                           If it is missing, Windows migrations ask for the full path
                           of virtio-win.iso (checked, then remembered in $VMEX_CONF).
                           Use an older ISO (e.g. 0.1.173) for Windows 7 / 2008 R2.
                           Giving an ISO here also keeps VirtIO for Windows 2012 R2
  -keep-virtio             Windows 2012 R2 and older: keep VirtIO disk/NIC. By default
                           they get SATA + e1000e and viostor is disabled, because
                           current virtio-win drivers fail signature checks there
                           (boot error viostor.sys 0xc0000428)

In-Transit Disk Streaming (-method stream):
  -stream-libdir DIR       Where its library is installed on this host (default:
                           /opt/vmware-vix-disklib-distrib; never on ESXi). If it is
                           missing, the script offers to install it from a
                           VMware-vix-disklib-*.tar.gz found in /root, /tmp, ... or
                           from a URL. Get VMware-vix-disklib 8.x for Linux from
                           Broadcom's developer portal (login needed), copy it here.
  -stream-tarball FILE     Install it from this .tar.gz if it is missing
  -stream-url URL          Download and install it from this URL if it is missing
  -stream-thumbprint XX:.. ESXi SHA1 certificate thumbprint (read automatically)
  -stream-transports MODES Transport(s), e.g. nbd or nbdssl (default: nbd -
                           unencrypted, faster; use nbdssl to encrypt the disk data)
  -stream-config FILE      Config file (default: generated with VMware's
                           recommended NFC buffers BufSizeIn64KB=16, BufCount=4)
  -esxi-password-file F    File with the ESXi password (else asked once, kept only
                           in memory/a 0600 temp file that is deleted on exit)

SAN (-method vmfs):
  -san-portal IP           iSCSI portal of the storage holding the ESXi datastores
  -san-target IQN          Target to use if the portal offers several
  -san-cleanup             Remove SAN access left behind by an interrupted run
                           The datastore LUN is logged in, set read-only at block
                           level and mounted read-only; when the run ends (or fails,
                           or is interrupted) it is unmounted, logged out and all
                           iSCSI records the script created are deleted.

Network:
  -network NAME            libvirt network for all NICs (default: default)
  -bridge BR               Host bridge for all NICs instead of a libvirt network
  -net-map 'SRC=TYPE:NAME' Map one ESXi portgroup, e.g. 'VM Network=bridge:br0'
                           or 'DMZ=network:dmz' (repeatable)
  -no-keep-mac             Let libvirt generate new MAC addresses

Source handling:
  -shutdown                Gracefully shut down a running/suspended source VM
  -force-off               Hard power-off if graceful shutdown times out
  -shutdown-timeout SEC    Default: 300
  -consolidate             Delete all snapshots / merge delta disks first
  -warm                    Warm migration of running VMs: copy while the VM runs (ESXi
                           snapshot), then shut it down and transfer only the 64 MiB
                           chunks that changed. Downtime = shutdown + ESXi checksumming
                           the disk + changed chunks + conversion. Uses the SSH copy.
  -repair-unclean          If Windows was not shut down cleanly, repair the copy instead
                           of stopping (Windows checks the disk at its first start on
                           VMeX; data being written when it went off is lost). Without
                           it, the run stops before copying and explains the fix.
  -cutover ask|auto        Warm migration: ask before shutting the VM down after the first
                           copy (default), or shut it down automatically. While asking,
                           'touch <log dir>/cutover-<VM>' from another terminal also confirms.
                           If ESXi locks the running VM's base disk, a temporary thin
                           copy is made on the same datastore (vmkfstools) and deleted
                           after pass 1; it needs free space ~ the data in the guest.
  -skip-rdm                Migrate without Raw Device Mapping disks

Transfer:
  -no-compress             Disable SSH compression (faster on 10GbE with thick disks)
  -verify                  md5 verify each copied disk (copy/raw methods)

After migration:
  -start                   Start the new domain
  -autostart               Enable autostart

General:
  -dry-run                 Inspect and print the plan, change nothing
  -y, -yes                 Do not ask for confirmation
  -log-dir DIR             Default: $LOG_DIR
                           Every run writes there:
                             <VM>.log                        everything about one VM
                             <VM>-v2v*.log, <VM>-domain.xml  conversion logs, VM definition
                             $PROG-<run>.log          whole run (menus, all VMs, summary)
                             $PROG-<run>.trace        every command executed (timestamped)
  -debug                   Also write V2V debug output (-v -x) to the VM logs
  -ignore-os               Run although the host is not Fedora $TARGET_FEDORA
  -force-in-transit        Convert Windows 2012 R2 and older in transit even though this
                           V2V cannot skip NTFS trimming (by default they use
                           the SSH copy, because they did not boot otherwise)
  -h, -help                Show this help${ac}

Examples:
  $PROG -sourcehost 10.0.0.60                       # interactive menus
  $PROG -sourcehost 10.0.0.60 -vm web01 -method vmfs -san-portal 1.1.1.1 -bridge br0
  $PROG -sourcehost 10.0.0.60 -setup
  $PROG -sourcehost 10.0.0.60 -list
  $PROG -sourcehost 10.0.0.60 -vm web01 -dry-run
  $PROG -sourcehost 10.0.0.60 -vm web01 -vm db01 -shutdown -bridge br0 -start
  $PROG -sourcehost 10.0.0.60 -all -shutdown -force-off -consolidate -net-map 'VM Network=bridge:br0' -y
EOF
}

parse_args() {
  local a v orig
  while (($#)); do
    # long options take one dash (-setup, -bridge); the two-dash form is still accepted
    orig=$1
    if [[ $1 =~ ^-[A-Za-z][A-Za-z0-9-]+(=.*)?$ ]]; then set -- "-$1" "${@:2}"; fi
    a=$1
    case $a in
      --*=*) v=${a#*=}; a=${a%%=*}; set -- "$a" "$v" "${@:2}" ;;
    esac
    case $1 in
      -sourcehost|--sourcehost|-H|--host) ESXI_HOST=$2; shift 2 ;;   # -H/--host: older name, still accepted
      -u|--user) ESXI_USER=$2; shift 2 ;;
      -p|--port) ESXI_PORT=$2; shift 2 ;;
      -k|--key) SSH_KEY=$2; SSH_KEY_FROM_CLI=1; shift 2 ;;
      --setup) ACTION=setup; shift ;;
      -installautocomplete|--installautocomplete) install_autocomplete; exit 0 ;;
      --list) ACTION=list; shift ;;
      -i|--interactive) ACTION=interactive; shift ;;
      --target-dir) TARGET_DIR=$2; shift 2 ;;
      --virtio-win) VIRTIO_WIN_DIR=$2; VIRTIO_CUSTOM=1; shift 2 ;;
      --vm) ACTION=migrate; VM_ARGS+=("$2"); shift 2 ;;
      --all) ACTION=migrate; MIGRATE_ALL=1; shift ;;
      --method) METHOD=$2; METHOD_FROM_CLI=1; shift 2 ;;
      --san-portal) SAN_PORTAL=$2; shift 2 ;;
      --stream-libdir|--vddk-libdir) VDDK_LIBDIR=$2; shift 2 ;;
      --stream-tarball|--vddk-tarball) VDDK_TARBALL=$2; shift 2 ;;
      --stream-url|--vddk-url) VDDK_URL=$2; shift 2 ;;
      --ignore-os) IGNORE_OS=1; shift ;;
      --debug) DEBUG=1; shift ;;
      --force-in-transit) FORCE_IN_TRANSIT=1; shift ;;
      --keep-virtio) KEEP_VIRTIO=1; shift ;;
      --stream-thumbprint|--vddk-thumbprint) VDDK_THUMB=$2; shift 2 ;;
      --stream-transports|--vddk-transports) VDDK_TRANSPORTS=$2; shift 2 ;;
      --stream-config|--vddk-config) VDDK_CONF=$2; shift 2 ;;
      --esxi-password-file) ESXI_PWFILE=$2; shift 2 ;;
      --san-target) SAN_TARGET=$2; shift 2 ;;
      --san-cleanup) ACTION=san-cleanup; shift ;;
      --no-fallback) FALLBACK=0; shift ;;
      --pool) POOL=$2; POOL_FROM_CLI=1; shift 2 ;;
      --format) FORMAT=$2; FORMAT_EXPLICIT=1; shift 2 ;;
      --target-name) TARGET_NAME=$2; shift 2 ;;
      --v2v-arg) V2V_EXTRA+=("$2"); shift 2 ;;
      --network) DEF_NET_TYPE=network; DEF_NET_NAME=$2; shift 2 ;;
      --bridge) DEF_NET_TYPE=bridge; DEF_NET_NAME=$2; shift 2 ;;
      --net-map)
        [[ $2 == *=*:* ]] || die "-net-map expects 'SRC=network:NAME' or 'SRC=bridge:NAME'"
        v=${2#*=}
        [[ ${v%%:*} == network || ${v%%:*} == bridge ]] || die "-net-map type must be network or bridge"
        NET_MAP["${2%%=*}"]=$v; shift 2 ;;
      --no-keep-mac) KEEP_MAC=0; shift ;;
      --shutdown) DO_SHUTDOWN=1; shift ;;
      --force-off) FORCE_OFF=1; shift ;;
      --shutdown-timeout) SHUTDOWN_TIMEOUT=$2; shift 2 ;;
      --consolidate) CONSOLIDATE=1; shift ;;
      --warm) WARM=1; DO_SHUTDOWN=1; shift ;;
      --repair-unclean) REPAIR_UNCLEAN=1; shift ;;
      --cutover) WARM_CUTOVER=$2; shift 2 ;;
      --skip-rdm) SKIP_RDM=1; shift ;;
      --no-compress) COMPRESS=0; shift ;;
      --min-free) MIN_FREE_GB=$2; shift 2 ;;
      --skip-space-check) SKIP_SPACE=1; shift ;;
      --verify) VERIFY=1; shift ;;
      --start) START_VM=1; shift ;;
      --autostart) AUTOSTART=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      -y|--yes) ASSUME_YES=1; YES_CLI=1; shift ;;
      --log-dir) LOG_DIR=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage; die "Unknown option: $orig" ;;
    esac
  done
  [[ -n $ESXI_HOST ]] || { usage; die "-sourcehost is required (the ESXi host to migrate from)"; }
  [[ -n $ACTION ]] || ACTION=interactive   # only -sourcehost given: ask what to do
  [[ -z $TARGET_DIR || $TARGET_DIR == /* ]] || die "-target-dir must be an absolute path"
  [[ $METHOD == stream ]] && METHOD=vddk   # shown as "stream"; vddk is the internal name
  [[ $METHOD =~ ^(auto|vddk|vmfs|v2v|copy|raw)$ ]] || die "-method must be auto, stream, vmfs, v2v, copy or raw"
  [[ $METHOD != vmfs || -n $SAN_PORTAL || $ACTION == interactive ]] || die "-method vmfs needs -san-portal IP"
  [[ $FORMAT =~ ^(qcow2|raw)$ ]] || die "-format must be qcow2 or raw"
  [[ $WARM_CUTOVER =~ ^(ask|auto)$ ]] || die "-cutover must be ask or auto"
  [[ $SHUTDOWN_TIMEOUT =~ ^[0-9]+$ ]] || die "-shutdown-timeout must be a number"
  [[ -z $MIN_FREE_GB || $MIN_FREE_GB =~ ^[0-9]+$ ]] || die "-min-free must be a number of GiB"
  if [[ -n $TARGET_NAME ]]; then
    ((MIGRATE_ALL == 0 && ${#VM_ARGS[@]} == 1)) || die "-target-name can only be used with a single -vm"
    TARGET_NAME=$(sanitize_name "$TARGET_NAME")
  fi
}

log_environment() {   # recorded at the top of every log file (not shown on screen)
  local v
  {
    echo "  Command            : $0 $*"
    echo "  Started            : $(date '+%F %T %Z') by $(id -un) on $(hostname)"
    echo "  OS                 : $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}"), kernel $(uname -r)"
    local r
    for v in virt-v2v libvirt-daemon-kvm qemu-kvm-core nbdkit libguestfs virtio-win; do
      r=$(rpm -q "$v" 2>/dev/null) || r="not installed"
      printf '  %-19s: %s\n' "${v/virt-v2v/V2V}" "${r%%$'\n'*}"
    done
    echo "  Trace              : $TRACE_FILE"
  } | while IFS= read -r v; do logfile_only "$v"; done
}

main() {
  parse_args "$@"
  mkdir -p "$LOG_DIR" && chmod 750 "$LOG_DIR" "${LOG_DIR%/*}" 2>/dev/null || true
  RUN_ID=$(date +%Y%m%d-%H%M%S)
  LOG_FILE="$LOG_DIR/$PROG-$RUN_ID.log"
  TRACE_FILE="$LOG_DIR/$PROG-$RUN_ID.trace"
  exec > >(tee -a "$LOG_FILE") 2>&1
  # full trace: every command with its arguments and a timestamp (passwords are never traced)
  exec {BASH_XTRACEFD}>>"$TRACE_FILE"
  PS4='+ ${EPOCHREALTIME:-} ${FUNCNAME[0]:-main}:${LINENO}: '
  set -x
  info "$PROG $VERSION ($PRODUCT_LABEL) - log:$LOG_FILE"
  log_environment "$@"
  os_check

  case $ACTION in
    setup) do_setup; exit 0 ;;
    san-cleanup) require_root; san_detach; exit 0 ;;
    list)
      pick_ssh_key
      [[ -f $SSH_KEY ]] || die "SSH key $SSH_KEY not found. Run first:  $PROG -sourcehost $ESXI_HOST -setup"
      init_ssh_opts; check_esxi; list_vms; exit 0 ;;
  esac

  require_root
  local t
  for t in ssh ssh-agent virsh virt-install qemu-img; do have "$t" || die "Missing '$t'. Run with -setup."; done
  have virt-v2v || { warn "V2V not installed; only copy/raw methods are possible"; [[ $METHOD == auto ]] && METHOD=raw; }
  [[ -e /dev/kvm ]] || die "/dev/kvm not present - enable hardware virtualization"
  v2v_features
  validate_v2v_extra
  logfile_only "V2V ${V2V_VERSION:-n/a}; --no-fstrim supported: $( ((V2V_HAS_NO_FSTRIM)) && echo yes || echo no)"
  pick_ssh_key
  init_ssh_opts
  start_agent
  check_esxi
  trap 'exit 130' INT TERM HUP   # make sure on_exit (SAN cleanup) runs on Ctrl+C
  check_storage_pools            # before the VM list: no pool = nothing to migrate to
  load_inventory
  [[ $ACTION == interactive ]] && interactive_select || true
  resolve_target_dir
  ensure_pool
  local plan_targets=()
  if ((MIGRATE_ALL)); then plan_targets=("${INV_ID[@]}"); else plan_targets=("${VM_ARGS[@]}"); fi
  ((${#plan_targets[@]})) && plan_space_check "${plan_targets[@]}"
  if [[ $METHOD == vddk ]]; then
    vddk_present || offer_vddk || true
    vddk_present && get_esxi_password || true
  fi
  if [[ $METHOD == vmfs ]]; then
    ((DRY_RUN)) && info "[dry-run] attaching the SAN read-only to verify access (removed again at the end)"
    san_attach
  fi

  local targets=() i
  if ((MIGRATE_ALL)); then
    for i in "${!INV_ID[@]}"; do targets+=("${INV_ID[i]}"); done
  else
    targets=("${VM_ARGS[@]}")
  fi
  ((${#targets[@]})) || die "Nothing to migrate"
  check_windows_prereqs "${targets[@]}"   # before any source VM is shut down

  local ok=() failed=() rc n=0 total=${#targets[@]} label t0 took vmlog vmlogs=()
  for t in "${targets[@]}"; do
    n=$((n + 1)); label=$(vm_label "$t"); t0=$SECONDS
    vmlog="$LOG_DIR/$(vm_log_name "$t").log"; vmlogs+=("$vmlog")
    printf '\n%s\n=== %s  run %s  %s %s  ESXi %s  VM: %s ===\n%s\n' "$(hr)" "$(date '+%F %T')" "$RUN_ID" "$PROG" "$VERSION" \
      "$ESXI_HOST" "$label" "$(hr)" >>"$vmlog" 2>/dev/null || true
    hr
    info "=== Migrating VM $n of $total: $label ===   (log: $vmlog)"
    hr
    trap - ERR; set +e
    # each VM isolated: one failure never stops the batch; its output also goes to its own log
    ( set -e; trap on_err ERR; migrate_vm "$t" ) 2>&1 | tee -a "$vmlog"
    rc=${PIPESTATUS[0]}
    set -e; trap on_err ERR
    took=$(duration $((SECONDS - t0)))
    hr
    if ((rc == 0)); then
      ok+=("$label  ($took)")
      info "=== VM $n of $total: $label has been migrated successfully ($took) ===" | tee -a "$vmlog"
    else
      local why=""
      [[ -r $vmlog ]] && why=$(grep '\[ERROR\]' "$vmlog" 2>/dev/null | tail -n 1 | sed 's/.*\[ERROR\] *//' | cut -c1-110) || true
      failed+=("$label${why:+  - $why}")
      err "=== VM $n of $total: $label FAILED - see the messages above ===" 2>&1 | tee -a "$vmlog"
    fi
    hr
    echo
  done

  san_detach
  hr
  info "Done. Succeeded: ${#ok[@]}  Failed: ${#failed[@]}  (of $total)"
  for t in "${ok[@]}"; do info "  OK     : $t"; done
  for t in "${failed[@]}"; do err "  FAILED : $t"; done
  hr
  info "Logs of this run ($LOG_DIR):"
  local lf
  for lf in "$LOG_DIR/$PROG-$RUN_ID"*; do [[ -e $lf ]] && info "  ${lf##*/}   (whole run)"; done
  for lf in "${vmlogs[@]}"; do [[ -e $lf ]] && info "  ${lf##*/}"; done
  if ((${#failed[@]})); then exit 1; fi
  exit 0
}

main "$@"
