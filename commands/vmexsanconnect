# ---------------------------------------------------------------------------
# Monitoring: -monitor checks this host's SAN connection; run every minute by a
# systemd timer (-monitor-enable). It warns only when something CHANGES:
#   wall message to logged-in users, journal (logger), log file event,
#   login banner ($MOTD_FILE) while not healthy, state file for a UI.
# ---------------------------------------------------------------------------
# health_snapshot -> HEALTH lines "key|ok/fail|message", HEALTH_STATUS ok/degraded/down
health_snapshot() {
  local proto states pp pstate rec host wwpn wwnn st sp model online=0
  local name wwid dm size hw groups paths bad prios fs
  HEALTH=(); HEALTH_STATUS=ok
  proto=$(effective_protocol)
  case $proto in
    iscsi)
      states=$(iscsi_session_states)
      for pp in "${ISCSI_PORTALS[@]}"; do
        pstate=$(awk -v ip="$pp" '$1 == ip {print $2; exit}' <<<"$states")
        if [[ $pstate == LOGGED_IN ]]; then HEALTH+=("session:$pp|ok|iSCSI to $pp connected")
        else HEALTH+=("session:$pp|fail|iSCSI to $pp DISCONNECTED${pstate:+ ($pstate)}"); fi
      done ;;
    fc*)
      collect_fc_ports
      for rec in "${FC_PORTS[@]}"; do
        IFS='|' read -r host wwpn wwnn st sp model <<<"$rec"
        if [[ $st == Online ]]; then HEALTH+=("fc:$wwpn|ok|FC port $host $wwpn Online")
        else HEALTH+=("fc:$wwpn|fail|FC port $host $wwpn $st"); fi
      done ;;
  esac
  if command -v multipath >/dev/null; then
    collect_volumes
    for rec in "${VOLUMES[@]}"; do
      IFS='|' read -r name wwid dm size hw groups paths bad prios fs <<<"$rec"
      if (( bad > 0 || paths < MIN_PATHS_PER_VOLUME )); then
        HEALTH+=("volume:$wwid|fail|Volume $name: $((paths - bad)) of $paths path(s) working (need $MIN_PATHS_PER_VOLUME)")
      else HEALTH+=("volume:$wwid|ok|Volume $name: $paths path(s) working"); fi
    done
    if (( ${#VOLUMES[@]} < EXPECTED_VOLUMES )); then
      HEALTH+=("volumes|fail|${#VOLUMES[@]} of $EXPECTED_VOLUMES SAN volume(s) visible")
    else HEALTH+=("volumes|ok|${#VOLUMES[@]} SAN volume(s) visible"); fi
  fi
  local h nfail=0 nok=0
  for h in "${HEALTH[@]}"; do [[ $h == *"|fail|"* ]] && nfail=$((nfail + 1)) || nok=$((nok + 1)); done
  if (( nfail == 0 )); then HEALTH_STATUS=ok
  elif [[ " ${HEALTH[*]} " == *"volumes|fail|0 of"* ]]; then HEALTH_STATUS=down
  else HEALTH_STATUS=degraded; fi
}

health_json() {
  local h k st m out=()
  for h in "${HEALTH[@]}"; do
    IFS='|' read -r k st m <<<"$h"
    out+=("{\"key\":$(jstr "$k"),\"status\":$(jstr "$st"),\"message\":$(jstr "$m")}")
  done
  printf '{"host":%s,"time":%s,"status":%s,"items":[%s]}' "$(jstr "$HOST_NAME")" "$(jstr "$(date -Is)")" \
    "$(jstr "$HEALTH_STATUS")" "$(join_by , "${out[@]}")"
}

# alert LEVEL TEXT - tell everyone who should know, once per change
alert() {
  local level=$1 text="vmexsanconnect on $HOST_NAME: $2"
  logger -t vmexsanconnect -p "user.$level" -- "$2" 2>/dev/null || true
  if command -v wall >/dev/null; then wall -- "$text" 2>/dev/null || true; fi
}

cmd_monitor() {
  # -all or another change is running: its own checks report, skip this round
  exec 8>"$LOCK_FILE" 2>/dev/null || true
  if ! flock -n 8 2>/dev/null; then
    say "Another $PROG run is in progress - monitoring skipped this time"
    RESULT_DATA='{"skipped":true}'; return 0
  fi
  # runs every minute: keep the log to real events (DISCONNECTED / RESTORED)
  [[ $LOG_LEVEL == DEBUG ]] && LOG_LEVEL=INFO
  local prev_file="$STATE_DIR/health.state" json_file="$STATE_DIR/health.json"
  local h k st m old changed=0 down_list=() up_list=()
  local -A before=()
  health_snapshot
  if [[ -f $prev_file ]]; then
    while IFS='|' read -r k st m; do [[ -n $k ]] && before[$k]=$st; done < "$prev_file"
  fi
  for h in "${HEALTH[@]}"; do
    IFS='|' read -r k st m <<<"$h"
    old=${before[$k]:-new}
    if [[ $st == fail && $old != fail ]]; then
      changed=1; down_list+=("$m")
      log WARN disconnected "DISCONNECTED: $m" key="$k"
    elif [[ $st == ok && $old == fail ]]; then
      changed=1; up_list+=("$m")
      log INFO restored "RESTORED: $m" key="$k"
    fi
  done
  (( ${#down_list[@]} )) && alert warning "SAN WARNING - $(join_by '; ' "${down_list[@]}") - check: $PROG -verify"
  (( ${#up_list[@]} ))   && alert notice  "SAN restored - $(join_by '; ' "${up_list[@]}")"

  mkdir -p "$STATE_DIR" 2>/dev/null
  printf '%s\n' "${HEALTH[@]}" > "$prev_file.tmp" && mv -f "$prev_file.tmp" "$prev_file"
  health_json > "$json_file.tmp" && mv -f "$json_file.tmp" "$json_file"

  # login banner while not healthy
  if [[ $HEALTH_STATUS == ok ]]; then
    rm -f "$MOTD_FILE"
  else
    mkdir -p "$(dirname "$MOTD_FILE")" 2>/dev/null
    {
      echo "*** SAN WARNING ($(date '+%F %T')) - $PROG reports: ${HEALTH_STATUS^^}"
      for h in "${HEALTH[@]}"; do [[ $h == *"|fail|"* ]] && echo "***   ${h##*|}"; done
      echo "*** Check: $PROG -verify"
    } > "$MOTD_FILE"
  fi

  say "SAN health on $HOST_NAME: ${HEALTH_STATUS^^}"
  for h in "${HEALTH[@]}"; do
    IFS='|' read -r k st m <<<"$h"
    if [[ $st == ok ]]; then say "  [ OK ] $m"; else say "  [FAIL] $m"; fi
  done
  if [[ $HEALTH_STATUS != ok ]]; then WARNINGS+=("SAN $HEALTH_STATUS"); fi
  RESULT_DATA=$(health_json)
}

cmd_monitor_enable() {
  local every=${ARGS[0]:-60} self
  valid_num "$every" && (( every >= 30 && every <= 3600 )) || { EXIT_CODE=3; fail "Usage: $PROG -monitor-enable [SECONDS 30-3600] (default 60)"; }
  self=$(readlink -f "$0" 2>/dev/null || echo "/usr/local/sbin/$TOOL_NAME")
  write_file "$UNIT_DIR/$MONITOR_UNIT.service" "Monitor service" 644 <<EOF
[Unit]
Description=vmexsanconnect - check the SAN connection and warn when it changes
After=network-online.target iscsid.service multipathd.service

[Service]
Type=oneshot
ExecStart=$self -monitor -quiet
# 2 = "not healthy": the tool already warned once - not a failure of the service
SuccessExitStatus=2
StandardOutput=null
EOF
  write_file "$UNIT_DIR/$MONITOR_UNIT.timer" "Monitor timer (every ${every}s)" 644 <<EOF
[Unit]
Description=Run vmexsanconnect -monitor every ${every} seconds

[Timer]
OnBootSec=2min
OnUnitActiveSec=${every}s
AccuracySec=5s

[Install]
WantedBy=timers.target
EOF
  run "Reload systemd" systemctl daemon-reload || fail "systemctl daemon-reload failed"
  run "Enable and start $MONITOR_UNIT.timer" systemctl enable --now "$MONITOR_UNIT.timer" || fail "Could not start the monitor timer"
  ok_ "SAN monitoring on: every ${every}s, warnings on change (wall, journal, login banner, $STATE_DIR/health.json)"
  RESULT_DATA="{\"enabled\":true,\"interval_seconds\":$every}"
}

cmd_monitor_disable() {
  if [[ -f $UNIT_DIR/$MONITOR_UNIT.timer ]]; then
    run "Stop and disable $MONITOR_UNIT.timer" systemctl disable --now "$MONITOR_UNIT.timer" || true
    run "Remove monitor units" rm -f "$UNIT_DIR/$MONITOR_UNIT.timer" "$UNIT_DIR/$MONITOR_UNIT.service"
    run "Reload systemd" systemctl daemon-reload || true
  fi
  [[ -f $MOTD_FILE ]] && run "Remove login banner" rm -f "$MOTD_FILE"
  ok_ "SAN monitoring off"
  RESULT_DATA='{"enabled":false}'
}

# -validate - read-only pre-flight check: is this host 100% ready for -all?
# fail = blocks -all, warn = -all can run but look at it, ok = fine
cmd_validate() {
  local proto p good=() bad=() rec st online=0 h ntp blocking before
  CHECKS=()
  before=${#ERRORS[@]}
  proto=$(effective_protocol)
  say "Validating $HOST_NAME for: $PROG -all"

  # --- host
  h=$(hostname -s 2>/dev/null || hostname)
  if [[ ${h,,} == localhost* || ${h,,} == linux ]]; then
    add_check hostname warn "Hostname is '$h' - give each host a unique name before building the cluster (vmexcluster -nodes)"
  else add_check hostname ok "Hostname $h"; fi
  ntp=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
  if [[ $ntp == yes ]]; then add_check time ok "Clock synchronised ($(timedatectl show -p Timezone --value 2>/dev/null))"
  else add_check time warn "Clock not synchronised - run: timedatectl set-ntp true"; fi

  # --- configuration
  case $proto in
    fc|fc*|iscsi|sas) add_check protocol ok "Protocol: $proto (configured: $PROTOCOL)" ;;
    *) add_check protocol fail "No protocol: no FC port online and ISCSI_PORTALS empty - run: $PROG -config-set PROTOCOL iscsi|fc" ;;
  esac
  if (( EXPECTED_VOLUMES >= 1 )); then add_check expected_volumes ok "Expecting $EXPECTED_VOLUMES volume(s) (EXPECTED_VOLUMES)"
  else add_check expected_volumes warn "EXPECTED_VOLUMES is 0 - set it: $PROG -config-set EXPECTED_VOLUMES <n>"; fi

  # --- packages: missing ones are installed by -all, but they must be downloadable
  required_packages "$proto"
  if (( ${#MISSING_PKGS[@]} == 0 )); then
    add_check packages ok "Required packages installed"
  elif query "Check that the missing packages can be downloaded" timeout 120 dnf -q list "${MISSING_PKGS[@]}"; then
    add_check packages ok "Missing packages are available and will be installed by -all: ${MISSING_PKGS[*]}"
  else
    add_check packages fail "Packages missing and not downloadable: ${MISSING_PKGS[*]} - check the dnf repositories / internet access"
  fi

  # --- multipath configuration that -all will replace
  if [[ -f /etc/multipath.conf ]] && ! grep -qs "Managed by vmexsanconnect" /etc/multipath.conf; then
    add_check multipath_conf warn "/etc/multipath.conf exists and will be replaced by -all (a backup is kept)"
  else add_check multipath_conf ok "/etc/multipath.conf can be written"; fi

  # --- protocol specific
  case $proto in
    iscsi)
      if (( ${#ISCSI_PORTALS[@]} == 0 )); then
        add_check portals fail "ISCSI_PORTALS is empty - run: $PROG -config-set ISCSI_PORTALS \"IP ...\""
      else
        for p in "${ISCSI_PORTALS[@]}"; do
          if check_portal "$p"; then good+=("$p"); else bad+=("$p"); fi
        done
        say ""
        if (( ${#bad[@]} == 0 )); then
          add_check portals ok "All ${#good[@]} configured portal(s) reachable: ${good[*]}"
        else
          add_check portals fail "Not reachable: ${bad[*]} - fix them or remove them from ISCSI_PORTALS (each configured portal must work)"
        fi
        if (( MIN_PATHS_PER_VOLUME > ${#ISCSI_PORTALS[@]} )); then
          add_check min_paths fail "MIN_PATHS_PER_VOLUME=$MIN_PATHS_PER_VOLUME but only ${#ISCSI_PORTALS[@]} portal(s) - -verify could never pass. Set: $PROG -config-set MIN_PATHS_PER_VOLUME ${#ISCSI_PORTALS[@]}"
        else add_check min_paths ok "MIN_PATHS_PER_VOLUME=$MIN_PATHS_PER_VOLUME fits ${#ISCSI_PORTALS[@]} portal(s)"; fi
        if (( MIN_PATH_GROUPS > ${#ISCSI_PORTALS[@]} )); then
          add_check min_groups fail "MIN_PATH_GROUPS=$MIN_PATH_GROUPS but only ${#ISCSI_PORTALS[@]} portal(s) - set: $PROG -config-set MIN_PATH_GROUPS ${#ISCSI_PORTALS[@]}"
        else add_check min_groups ok "MIN_PATH_GROUPS=$MIN_PATH_GROUPS fits ${#ISCSI_PORTALS[@]} portal(s)"; fi
      fi
      if [[ -n $(current_iqn) ]]; then
        add_check iqn ok "Initiator IQN: $(current_iqn)"
      elif [[ -n $INITIATOR_IQN ]]; then
        add_check iqn ok "Initiator IQN will be set to $INITIATOR_IQN"
      else
        add_check iqn warn "No initiator IQN yet - it is created by -all; register it on the array before -all (run: $PROG -install && systemctl start iscsid && $PROG -identifiers)"
      fi
      ;;
    fc*)
      collect_fc_ports
      for rec in "${FC_PORTS[@]}"; do IFS='|' read -r _ _ _ st _ _ <<<"$rec"; [[ $st == Online ]] && online=$((online + 1)); done
      if (( ${#FC_PORTS[@]} == 0 )); then
        add_check fc_ports fail "No FC ports - check the HBA, or run: $PROG -load-driver"
      elif (( online == 0 )); then
        add_check fc_ports fail "0 of ${#FC_PORTS[@]} FC ports Online - check cables, SFPs and switch ports ($PROG -fc-status)"
      elif (( online < ${#FC_PORTS[@]} )); then
        add_check fc_ports warn "$online of ${#FC_PORTS[@]} FC ports Online"
      else add_check fc_ports ok "All ${#FC_PORTS[@]} FC ports Online"; fi
      if (( MIN_PATHS_PER_VOLUME > online && online > 0 )); then
        add_check min_paths warn "MIN_PATHS_PER_VOLUME=$MIN_PATHS_PER_VOLUME with $online port(s) online - each port must see the array through the switch zoning"
      fi
      ;;
  esac

  # --- what this host cannot check: the array side
  say ""
  say "On the array (cannot be checked from this host before connecting):"
  say "  - this host is defined with the identifiers from: $PROG -identifiers"
  say "  - the volume(s) are mapped to this host"

  blocking=$(( ${#ERRORS[@]} - before ))
  say ""
  if (( blocking == 0 )); then
    log INFO check_ok "READY - run: $PROG -all"
  else
    log ERROR validate "NOT READY - $blocking item(s) to fix (marked FAIL above)"
  fi
  RESULT_DATA="{\"ready\":$(jbool "$(( blocking == 0 ))"),\"blocking\":$blocking,\"protocol\":$(jstr "$proto"),\"checks\":[$(join_by , "${CHECKS[@]}")]}"
}

cmd_all() {
  local step before steps_done=()
  if [[ $CONFIG_LOADED == defaults ]]; then write_config; fi

  # pre-flight: refuse to start when something blocks (-force skips this)
  if [[ " ${ARGS[*]:-} " == *" --force "* ]]; then
    warn_ "Validation skipped (-force)"
  else
    before=${#ERRORS[@]}
    log INFO step_start "=== Step: validate ===" step="validate"
    cmd_validate
    log INFO step_end "=== Step done: validate ===" step="validate"
    if (( ${#ERRORS[@]} > before )); then
      err_ "Not ready - nothing was changed. Fix the FAIL items above (or run with -force)"
      RESULT_DATA="{\"steps\":[\"validate\"],\"validate\":${RESULT_DATA}}"
      return 0
    fi
    steps_done+=("validate")
  fi
  for step in install load-driver iscsi-setup multipath-config rescan verify; do
    before=${#ERRORS[@]}
    log INFO step_start "=== Step: $step ===" step="$step"
    "cmd_${step//-/_}"
    log INFO step_end "=== Step done: $step ===" step="$step"
    steps_done+=("$step")
    if (( ${#ERRORS[@]} > before )) && [[ $step != verify ]]; then
      err_ "Stopping after failed step: $step"; break
    fi
  done
  # keep watching the connection from now on (warns when it drops)
  if [[ " ${steps_done[*]} " == *" verify "* ]] && [[ ! -f $UNIT_DIR/$MONITOR_UNIT.timer ]]; then
    local vdata=$RESULT_DATA
    log INFO step_start "=== Step: monitor-enable ===" step="monitor-enable"
    ARGS=(); cmd_monitor_enable
    log INFO step_end "=== Step done: monitor-enable ===" step="monitor-enable"
    steps_done+=("monitor-enable"); RESULT_DATA=$vdata
  fi
  # RESULT_DATA from verify is kept; wrap it with the step list
  RESULT_DATA="{\"steps\":$(jarr_str "${steps_done[@]}"),\"verify\":${RESULT_DATA}}"
}

cmd_show_config() {
  say "Config file: $CONFIG_FILE ($CONFIG_LOADED)"
  say "  PROTOCOL                  = $PROTOCOL"
  say "  ISCSI_PORTALS             = ${ISCSI_PORTALS[*]:-}"
  say "  ISCSI_PORT                = $ISCSI_PORT"
  local iqn_shown=${INITIATOR_IQN:-"(keep the Fedora generated IQN)"}
  say "  INITIATOR_IQN             = $iqn_shown"
  say "  CHAP_USER                 = ${CHAP_USER:-(none)}"
  say "  CHAP_PASS                 = $([[ -n $CHAP_PASS ]] && echo '******** (set)' || echo '(none)')"
  say "  ISCSI_REPLACEMENT_TIMEOUT = $ISCSI_REPLACEMENT_TIMEOUT"
  say "  EXPECTED_VOLUMES          = $EXPECTED_VOLUMES"
  say "  MIN_PATHS_PER_VOLUME      = $MIN_PATHS_PER_VOLUME"
  say "  MIN_PATH_GROUPS           = $MIN_PATH_GROUPS"
  say "  LOG_DIR                   = $LOG_DIR"
  say "  LOG_LEVEL                 = $LOG_LEVEL"
  local w
  say "  VOLUME_ALIASES            = ${#VOLUME_ALIASES[@]}"
  for w in "${!VOLUME_ALIASES[@]}"; do say "      $w -> ${VOLUME_ALIASES[$w]}"; done
  RESULT_DATA=$(config_json)
}

cmd_init_config() {
  if [[ $CONFIG_LOADED == existing && ${ARGS[0]:-} != --force ]]; then
    warn_ "$CONFIG_FILE already exists - use: $PROG -init-config -force to reset it"
  else
    set_defaults
    write_config
    ok_ "Default configuration written to $CONFIG_FILE"
  fi
  RESULT_DATA=$(config_json)
}

valid_ip() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
valid_num() { [[ $1 =~ ^[0-9]+$ ]]; }

cmd_config_set() {
  (( ${#ARGS[@]} >= 1 )) || { EXIT_CODE=3; fail "Usage: $PROG -config-set KEY [VALUE]"; }
  local key=${ARGS[0]} val="${ARGS[*]:1}" p old shown
  case $key in
    PROTOCOL)
      [[ $val =~ ^(fc|iscsi|sas|auto)$ ]] || fail "PROTOCOL must be fc, iscsi, sas or auto"
      old=$PROTOCOL; PROTOCOL=$val ;;
    ISCSI_PORTALS)
      old="${ISCSI_PORTALS[*]:-}"; ISCSI_PORTALS=()
      for p in ${val//,/ }; do valid_ip "$p" || fail "Invalid IP address: $p"; ISCSI_PORTALS+=("$p"); done ;;
    ISCSI_PORT|ISCSI_REPLACEMENT_TIMEOUT|EXPECTED_VOLUMES|MIN_PATHS_PER_VOLUME|MIN_PATH_GROUPS)
      valid_num "$val" || fail "$key must be a number"
      old=${!key}; printf -v "$key" '%s' "$val" ;;
    INITIATOR_IQN)
      [[ -z $val || $val =~ ^iqn\.[0-9]{4}-[0-9]{2}\.[^[:space:]]+$ ]] || fail "INITIATOR_IQN must look like iqn.YYYY-MM.domain:name"
      old=$INITIATOR_IQN; INITIATOR_IQN=$val ;;
    CHAP_USER) old=$CHAP_USER; CHAP_USER=$val ;;
    CHAP_PASS) old="(hidden)"; CHAP_PASS=$val ;;
    LOG_LEVEL)
      [[ $val =~ ^(DEBUG|INFO|WARN|ERROR)$ ]] || fail "LOG_LEVEL must be DEBUG, INFO, WARN or ERROR"
      old=$LOG_LEVEL; LOG_LEVEL=$val ;;
    LOG_DIR)
      [[ $val == /* ]] || fail "LOG_DIR must be an absolute path"
      old=$LOG_DIR; LOG_DIR=$val ;;
    *) EXIT_CODE=3; fail "Unknown key '$key'. Keys: PROTOCOL ISCSI_PORTALS ISCSI_PORT INITIATOR_IQN CHAP_USER CHAP_PASS ISCSI_REPLACEMENT_TIMEOUT EXPECTED_VOLUMES MIN_PATHS_PER_VOLUME MIN_PATH_GROUPS LOG_DIR LOG_LEVEL" ;;
  esac
  shown=$val; if [[ $key == CHAP_PASS ]]; then shown="(hidden)"; fi
  write_config || fail "Could not save configuration"
  log INFO config_changed "$key: '$old' -> '$shown'" key="$key" old="$old" new="$shown"
  say "$key = $shown"
  RESULT_DATA=$(config_json)
}

cmd_alias_set() {
  (( ${#ARGS[@]} == 2 )) || { EXIT_CODE=3; fail "Usage: $PROG -alias-set WWID ALIAS"; }
  local wwid=${ARGS[0]} alias=${ARGS[1]} w
  [[ $wwid =~ ^[0-9a-fA-F]{8,}$ ]] || fail "WWID must be hexadecimal (see: $PROG -volumes)"
  [[ $alias =~ ^[A-Za-z0-9_.-]+$ ]] || fail "Alias may only contain letters, digits, _ . -"
  for w in "${!VOLUME_ALIASES[@]}"; do
    if [[ ${VOLUME_ALIASES[$w]} == "$alias" && $w != "$wwid" ]]; then fail "Alias $alias already used for $w"; fi
  done
  VOLUME_ALIASES[$wwid]=$alias
  write_config || fail "Could not save configuration"
  log INFO alias_set "Alias $alias -> $wwid (apply with: $PROG -multipath-config)" wwid="$wwid" alias="$alias"
  say "Alias saved. Apply with: $PROG -multipath-config   (do the same on the other host)"
  RESULT_DATA=$(config_json)
}

cmd_alias_remove() {
  (( ${#ARGS[@]} == 1 )) || { EXIT_CODE=3; fail "Usage: $PROG -alias-remove WWID"; }
  local wwid=${ARGS[0]}
  [[ -n ${VOLUME_ALIASES[$wwid]:-} ]] || fail "No alias set for $wwid"
  unset "VOLUME_ALIASES[$wwid]"
  write_config || fail "Could not save configuration"
  log INFO alias_removed "Alias removed for $wwid (apply with: $PROG -multipath-config)" wwid="$wwid"
  RESULT_DATA=$(config_json)
}

cmd_logs() {
  local n=${ARGS[0]:-50} rid=${ARGS[1]:-} lines
  valid_num "$n" || { EXIT_CODE=3; fail "Usage: $PROG -logs [COUNT] [RUN_ID]"; }
  if (( JSON_OUT )); then
    if [[ -n $rid ]]; then lines=$(grep -F "\"run_id\":\"$rid\"" "$JSONL_FILE" 2>/dev/null | tail -n "$n")
    else lines=$(tail -n "$n" "$JSONL_FILE" 2>/dev/null); fi
    RESULT_DATA="[$(paste -sd, - <<<"$lines" | sed 's/^,*$//')]"
  else
    if [[ -n $rid ]]; then grep -F "run=$rid " "$LOG_FILE" | tail -n "$n"
    else tail -n "$n" "$LOG_FILE"; fi
  fi
}

cmd_runs() {
  local n=${ARGS[0]:-20} lines
  valid_num "$n" || { EXIT_CODE=3; fail "Usage: $PROG -runs [COUNT]"; }
  lines=$(grep -F '"event":"run_end"' "$JSONL_FILE" 2>/dev/null | tail -n "$n")
  if (( JSON_OUT )); then
    RESULT_DATA="[$(paste -sd, - <<<"$lines" | sed 's/^,*$//')]"
  else
    grep -F ' run_end: ' "$LOG_FILE" 2>/dev/null | tail -n "$n"
  fi
}

# ---------------------------------------------------------------------------
# Bash Tab completion: the script below is vmexsanconnect.bash-completion,
# built in so that one file installs everything.
# ---------------------------------------------------------------------------
completion_script() {
  cat <<'VMEXSANCONNECT_COMPLETION_EOF'
# =============================================================================
#  Tool        : vmexsanconnect.bash-completion
#  Description : Bash Tab completion for the vmexsanconnect command
#  Version     : 1.10  (matches vmexsanconnect 1.13)
#  Last change : 1.10 (2026-11-16) - New switch -cluster-ready.
# =============================================================================
#
#  Versioning: bump the version on every change and update "Last change".
#  When vmexsanconnect gets a new command or option, add it here too.
#
#  CHANGELOG
#  ---------
#  1.10 2026-11-16  -cluster-ready.
#  1.9  2026-11-16  -troubleshoot, completing ISCSI_PORTALS and network card names.
#  1.8  2026-11-15  -monitor, -monitor-enable (offers 30 60 120 300), -monitor-disable.
#  1.7  2026-11-15  -validate; -force after -all (skips the validation).
#  1.6  2026-11-15  -iscsi-test, completing the ISCSI_PORTALS from the config.
#  1.5  2026-11-15  WWID completion covers IBM 2145 arrays as well as Lenovo DE-Series.
#  1.4  2026-11-11  All commands and options completed as single-dash switches, like
#                   vmexhealthcheck: -all -verify -volumes -config -json -dry-run ...
#                   Options are still offered after a command switch; arguments
#                   (config keys, WWIDs, run IDs) are counted correctly after options.
#  1.3  2026-11-03  Install location /usr/share/bash-completion/completions/vmexsanconnect
#                   (file must be named exactly like the command there). New words:
#                   install-completion, --installautocomplete. This file is now also
#                   built into vmexsanconnect, which installs it.
#  1.2  2026-10-31  Run ID completion reads logs from /var/log/vmex/ (or LOG_DIR).
#  1.1  2026-10-31  Install location changed to /etc/bash_completion.d/.
#  1.0  2026-10-31  First release.
#
#  Install:  vmexsanconnect -installautocomplete
#     (or by hand: install -m 644 vmexsanconnect.bash-completion \
#                  /usr/share/bash-completion/completions/vmexsanconnect)
#  Loaded automatically the first time Tab is pressed after "vmexsanconnect"
#  in a NEW bash shell (needs the bash-completion package).
# -----------------------------------------------------------------------------

_vmexsanconnect_wwids() {
    # WWIDs of SAN volumes (DE-Series, IBM 2145) visible to multipath, plus WWIDs in the config
    {
        multipath -ll 2>/dev/null | awk '/LENOVO,DE_Series|IBM,2145/ { w = $1; if ($2 ~ /^\(/) { w = $2; gsub(/[()]/, "", w) } print w }'
        sed -n 's/.*\[\([0-9a-fA-F]\{8,\}\)\]=.*/\1/p' \
            "${VMEXSANCONNECT_CONFIG:-/etc/vmexsanconnect/vmexsanconnect.conf}" 2>/dev/null
    } | sort -u
}

_vmexsanconnect_alias_wwids() {
    # Only WWIDs that currently have an alias in the config
    grep -o '\[[0-9a-fA-F]\{8,\}\]' \
        "${VMEXSANCONNECT_CONFIG:-/etc/vmexsanconnect/vmexsanconnect.conf}" 2>/dev/null | tr -d '[]'
}

_vmexsanconnect_run_ids() {
    local logdir
    logdir=$(sed -n 's/^LOG_DIR=//p' "${VMEXSANCONNECT_CONFIG:-/etc/vmexsanconnect/vmexsanconnect.conf}" 2>/dev/null)
    logdir=${logdir:-/var/log/vmex}
    [[ $logdir == /var/log/vmexsanconnect ]] && logdir=/var/log/vmex
    grep -o '"run_id":"[^"]*"' "$logdir/vmexsanconnect.jsonl" 2>/dev/null \
        | cut -d'"' -f4 | sort -u | tail -n 30
}

_vmexsanconnect() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null; then
        _init_completion || return
    else
        cur=${COMP_WORDS[COMP_CWORD]}; prev=${COMP_WORDS[COMP_CWORD-1]}
        words=("${COMP_WORDS[@]}"); cword=$COMP_CWORD
    fi

    # every command and option is a single-dash switch
    local commands="-cluster-ready -troubleshoot -monitor -monitor-enable -monitor-disable -validate -all -install -load-driver -iscsi-setup -multipath-config -rescan
                    -detect -identifiers -fc-status -status -volumes -verify -iscsi-test
                    -config -init-config -config-set -alias-set -alias-remove
                    -logs -runs -installautocomplete -help -version"
    local options="-json -dry-run -verbose -quiet -config-file"
    local keys="PROTOCOL ISCSI_PORTALS ISCSI_PORT INITIATOR_IQN CHAP_USER CHAP_PASS
                ISCSI_REPLACEMENT_TIMEOUT EXPECTED_VOLUMES MIN_PATHS_PER_VOLUME
                MIN_PATH_GROUPS LOG_DIR LOG_LEVEL"
    local cmdnames=" cluster-ready troubleshoot monitor monitor-enable monitor-disable validate iscsi-test all install load-driver iscsi-setup multipath-config rescan detect identifiers fc-status status volumes verify config show-config init-config config-set alias-set alias-remove logs runs installautocomplete install-completion help version "

    # -config-file FILE
    if [[ $prev == -config-file || $prev == --config-file ]]; then
        COMPREPLY=($(compgen -f -- "$cur"))
        return
    fi

    # Find the command switch (dashes optional; old plain words still count)
    local i w cmd="" cmd_idx=0
    for (( i = 1; i < cword; i++ )); do
        w=${words[i]#-}; w=${w#-}
        if [[ $w == config-file ]]; then (( i++ )); continue; fi
        if [[ $cmdnames == *" $w "* ]]; then cmd=$w; cmd_idx=$i; break; fi
    done
    case $cmd in
        config) cmd=show-config ;;
        installautocomplete) cmd=install-completion ;;
    esac

    if [[ -z $cmd ]]; then
        # nothing chosen yet: offer every switch
        COMPREPLY=($(compgen -W "$commands $options" -- "$cur"))
        return
    fi

    if [[ $cur == -* ]]; then
        local extra=""
        [[ $cmd == init-config || $cmd == all ]] && extra="-force"
        COMPREPLY=($(compgen -W "$options $extra" -- "$cur"))
        return
    fi

    # argn = position of the current word among the command's own arguments
    local argn=1
    for (( i = cmd_idx + 1; i < cword; i++ )); do
        case ${words[i]} in
            -config-file|--config-file) (( i++ )) ;;
            -*) ;;
            *) (( argn++ )) ;;
        esac
    done
    case $cmd in
        config-set)
            if (( argn == 1 )); then
                COMPREPLY=($(compgen -W "$keys" -- "$cur"))
            elif (( argn == 2 )); then
                case $prev in
                    PROTOCOL)  COMPREPLY=($(compgen -W "fc iscsi sas auto" -- "$cur")) ;;
                    LOG_LEVEL) COMPREPLY=($(compgen -W "DEBUG INFO WARN ERROR" -- "$cur")) ;;
                    LOG_DIR)   COMPREPLY=($(compgen -d -- "$cur")) ;;
                    EXPECTED_VOLUMES|MIN_PATHS_PER_VOLUME|MIN_PATH_GROUPS)
                               COMPREPLY=($(compgen -W "1 2 3 4 5 6 7 8" -- "$cur")) ;;
                    ISCSI_PORT) COMPREPLY=($(compgen -W "3260" -- "$cur")) ;;
                    INITIATOR_IQN)
                        local iqn
                        iqn=$(sed -n 's/^InitiatorName=//p' /etc/iscsi/initiatorname.iscsi 2>/dev/null)
                        COMPREPLY=($(compgen -W "$iqn" -- "$cur")) ;;
                esac
            fi ;;
        alias-set)
            if (( argn == 1 )); then
                COMPREPLY=($(compgen -W "$(_vmexsanconnect_wwids)" -- "$cur"))
            fi ;;
        alias-remove)
            if (( argn == 1 )); then
                COMPREPLY=($(compgen -W "$(_vmexsanconnect_alias_wwids)" -- "$cur"))
            fi ;;
        logs)
            if (( argn == 1 )); then
                COMPREPLY=($(compgen -W "20 50 100 200 500" -- "$cur"))
            elif (( argn == 2 )); then
                COMPREPLY=($(compgen -W "$(_vmexsanconnect_run_ids)" -- "$cur"))
            fi ;;
        troubleshoot)
            COMPREPLY=($(compgen -W "$(sed -n 's/^ISCSI_PORTALS=(\(.*\))/\1/p' "${VMEXSANCONNECT_CONFIG:-/etc/vmexsanconnect/vmexsanconnect.conf}" 2>/dev/null | tr -d "'\"") $(ls /sys/class/net 2>/dev/null | grep -v '^lo$')" -- "$cur")) ;;
        monitor-enable)
            (( argn == 1 )) && COMPREPLY=($(compgen -W "30 60 120 300" -- "$cur")) ;;
        iscsi-test)
            # the portal IPs from the config: ISCSI_PORTALS=( 10.10.10.231 ... )
            COMPREPLY=($(compgen -W "$(sed -n 's/^ISCSI_PORTALS=(\(.*\))/\1/p' "${VMEXSANCONNECT_CONFIG:-/etc/vmexsanconnect/vmexsanconnect.conf}" 2>/dev/null | tr -d "'\"")" -- "$cur")) ;;
        runs)
            if (( argn == 1 )); then
                COMPREPLY=($(compgen -W "10 20 50 100" -- "$cur"))
            fi ;;
    esac
}

complete -F _vmexsanconnect vmexsanconnect
VMEXSANCONNECT_COMPLETION_EOF
}

cmd_install_completion() {
  local dest="$COMPLETION_DIR/$TOOL_NAME" f loaded=0 lazy="no"
  # bash-completion only lazy-loads a file named exactly like the command
  [[ -d $COMPLETION_DIR ]] || run "Create $COMPLETION_DIR" mkdir -p "$COMPLETION_DIR" \
    || fail "Cannot create $COMPLETION_DIR"
  completion_script | write_file "$dest" "Install bash completion" 644 || fail "Could not write $dest"
  if command -v restorecon >/dev/null && (( ! DRY_RUN )); then
    run "Apply SELinux label to $dest" restorecon "$dest" || true
  fi

  # older copies: a wrongly named file here never loads; the /etc one is replaced by this
  for f in "$COMPLETION_DIR/$TOOL_NAME.bash-completion" \
           /etc/bash_completion.d/$TOOL_NAME.bash-completion /etc/bash_completion.d/$TOOL_NAME; do
    if [[ -e $f ]]; then run "Remove old completion file $f" rm -f "$f" || warn_ "Could not remove $f"; fi
  done

  if ! rpm -q bash-completion >/dev/null 2>&1 && [[ ! -f /usr/share/bash-completion/bash_completion ]]; then
    warn_ "Package bash-completion is not installed - Tab completion will not load. Run: dnf install -y bash-completion"
  fi

  if (( ! DRY_RUN )); then
    # 1) the file itself registers the completion
    if query "Check that the completion file loads" bash -c 'source "$1" && complete -p "$2"' _ "$dest" "$TOOL_NAME"; then
      loaded=1; ok_ "Completion file loads: $RUN_OUT"
    else
      err_ "The installed completion file does not load - see the log"
    fi
    # 2) bash-completion finds it on its own (what happens when you press Tab)
    if [[ -f /usr/share/bash-completion/bash_completion ]] && query "Check that bash-completion finds it" bash -c '
        source /usr/share/bash-completion/bash_completion >/dev/null 2>&1
        if declare -F _comp_load >/dev/null; then _comp_load "$1"
        elif declare -F __load_completion >/dev/null; then __load_completion "$1"; fi
        complete -p "$1"' _ "$TOOL_NAME"; then
      lazy="yes"; ok_ "bash-completion loads it automatically"
    elif [[ -f /usr/share/bash-completion/bash_completion && $COMPLETION_DIR == /usr/share/bash-completion/completions ]]; then
      warn_ "bash-completion did not pick it up automatically - check: rpm -q bash-completion"
    fi
  fi

  say ""
  say "Tab completion installed: $dest"
  say "It works in every NEW shell. For this shell run:"
  say "  source $dest"
  RESULT_DATA="{\"file\":$(jstr "$dest"),\"loads\":$(jbool "$loaded"),\"autoload\":$(jstr "$lazy"),\"completion_version\":$(jstr "$(completion_script | sed -n 's/^#  Version *: *\([0-9.]*\).*/\1/p' | head -1)")}"
}

usage() {
  cat <<EOF
$PROG $VERSION - connect this host to a SAN with DM-Multipath
         (Lenovo ThinkSystem DE-Series, IBM Storwize / FlashSystem / SVC)

Usage: $PROG -<command> [arguments] [options]        e.g.  $PROG -verify -json

Setup (changes the system, logged, locked against parallel runs):
  -validate                  Pre-flight check: is this host 100% ready for -all?
                             Ends with READY or NOT READY (changes nothing)
  -all [-force]              Full workflow: -validate, -install, -load-driver,
                             -iscsi-setup, -multipath-config, -rescan, -verify
                             (stops before changing anything if -validate fails;
                             -force skips the validation)
  -install                   Install required packages and log rotation
  -load-driver               Load the HBA driver (Emulex lpfc / QLogic qla2xxx)
  -iscsi-setup               Configure initiator, discover and log in (iSCSI only)
  -multipath-config          Write /etc/multipath.conf, enable and reload multipathd
  -rescan                    Rescan FC/iSCSI/SCSI buses and reload multipath maps

Read-only:
  -detect                    OS, kernel, HBAs, FC ports, detected protocol
  -identifiers               WWPNs / IQN to register on the array
  -fc-status                 FC port link state and speed
  -status                    Identifiers + volumes summary
  -volumes                   SAN multipath volumes (WWID, size, paths, fstype)
  -verify                    Health checks (paths, controllers, multipathd, VMFS);
                             ends with "[OK] Ready for vmex cluster" + [Warning] lines
  -cluster-ready             Only those verdict lines (for vmexcluster -validate):
                             exit 0 = ready (warnings allowed), 1 = not ready
  -monitor                   SAN health now (sessions, FC ports, paths, volumes);
                             warns on change - normally run by the timer
  -troubleshoot [IP|card ...]
                             When a portal does not answer: listens on the cable,
                             asks every address of the subnet, checks the card
                             (errors, duplicate IP, received packets), explains
                             what is on the other end and how to fix it
                             (default: ISCSI_PORTALS)
  -iscsi-test [IP ...]       Check iSCSI portals step by step: route, link, ARP,
                             ping, port 3260 and which array target answers
                             (default: the configured ISCSI_PORTALS)

Monitoring (switched on by -all):
  -monitor-enable [SECONDS]  Check every SECONDS (default 60); on a change: message
                             to logged-in users, journal, login banner, health.json
  -monitor-disable           Switch monitoring off

Configuration ($CONFIG_FILE):
  -config                    Show current settings
  -init-config [-force]      Write default settings
  -config-set KEY VALUE      Change one setting, e.g.
                               -config-set PROTOCOL fc
                               -config-set ISCSI_PORTALS "10.0.1.10 10.0.2.10"
                               -config-set EXPECTED_VOLUMES 1
  -alias-set WWID ALIAS      Name a volume (same name on every host)
  -alias-remove WWID         Remove a volume name

Logs:
  -logs [COUNT] [RUN_ID]     Last log events (all runs, or one run)
  -runs [COUNT]              Recent runs with command, result and duration

Bash Tab completion:
  -installautocomplete       Install it to $COMPLETION_DIR/$TOOL_NAME

  -help                      This help
  -version                   Tool version and last change

Options (combine with any command):
  -json                      Result as one JSON object on stdout; progress as
                             JSON lines on stderr (for a UI)
  -dry-run                   Show and log what would change, change nothing
  -verbose                   Show DEBUG events and command output on the console
  -quiet                     Console shows warnings and errors only
  -config-file FILE          Use another config file (or env VMEXSANCONNECT_CONFIG)

"--" works as well as "-" (e.g. --verify), and the older plain words (verify) still work.
Logs: \$LOG_DIR/vmexsanconnect.log (text) and \$LOG_DIR/vmexsanconnect.jsonl (JSON lines),
      default LOG_DIR=/var/log/vmex. Every event carries a run_id.
Exit codes: 0 ok, 1 error, 2 warnings, 3 usage error, 4 another run active
EOF
}

###############################################################################
# Run lifecycle
###############################################################################
finish() {
  local rc=$EXIT_CODE
  if (( rc == 0 )); then
    if (( ${#ERRORS[@]} > 0 )); then rc=1
    elif (( ${#WARNINGS[@]} > 0 )); then rc=2; fi
  fi
  local dur=$(( $(date +%s%3N) - RUN_START_MS ))
  if (( ! NO_RUN_LOG )); then
    log INFO run_end "Run finished: command=$COMMAND exit=$rc warnings=${#WARNINGS[@]} errors=${#ERRORS[@]} duration=${dur}ms" \
      exit_code="$rc" warnings="${#WARNINGS[@]}" errors="${#ERRORS[@]}" duration_ms="$dur" dry_run="$DRY_RUN"
  fi
  if (( JSON_OUT )) && (( ! SKIP_RESULT )); then
    printf '{"ok":%s,"exit_code":%s,"command":%s,"args":%s,"run_id":%s,"host":%s,"version":%s,"dry_run":%s,"duration_ms":%s,"log_file":%s,"jsonl_file":%s,"warnings":%s,"errors":%s,"data":%s}\n' \
      "$(jbool "$(( rc == 0 || rc == 2 ))")" "$rc" "$(jstr "$COMMAND")" "$(jarr_str "${ARGS[@]}")" "$(jstr "$RUN_ID")" \
      "$(jstr "$HOST_NAME")" "$(jstr "$VERSION")" "$(jbool "$DRY_RUN")" "$dur" "$(jstr "$LOG_FILE")" "$(jstr "$JSONL_FILE")" \
      "$(jarr_str "${WARNINGS[@]}")" "$(jarr_str "${ERRORS[@]}")" "${RESULT_DATA:-null}"
  elif (( ! JSON_OUT )) && (( ! NO_RUN_LOG )) && (( ! NO_RUN_LOG_SUMMARY )) && [[ -n $COMMAND ]]; then
    case $rc in
      0) printf '%sDone.%s\n' "$C_OK" "$C_OFF" >&2 ;;
      2) printf '%sDone with %d warning(s).%s Run id %s, log %s\n' "$C_WRN" "${#WARNINGS[@]}" "$C_OFF" "$RUN_ID" "${LOG_FILE:-console}" >&2 ;;
      *) printf '%sFailed (exit %d).%s Run id %s, log %s\n' "$C_ERR" "$rc" "$C_OFF" "$RUN_ID" "${LOG_FILE:-console}" >&2 ;;
    esac
  fi
  exit "$rc"
}

acquire_lock() {
  exec 9>"$LOCK_FILE" || fail "Cannot open lock file $LOCK_FILE"
  if ! flock -n 9; then
    EXIT_CODE=4
    err_ "Another $PROG run is in progress (lock $LOCK_FILE)"
    exit 4
  fi
  log DEBUG lock "Lock acquired" lock="$LOCK_FILE"
}

###############################################################################
# Main
###############################################################################
# Every command and option is a switch: -verify, -json ... ("--verify" works too).
# The older plain words (verify, show-config ...) are still accepted.
KNOWN_COMMANDS=" cluster-ready troubleshoot monitor monitor-enable monitor-disable validate iscsi-test all install load-driver iscsi-setup multipath-config rescan detect identifiers fc-status status volumes verify show-config init-config config-set alias-set alias-remove logs runs install-completion help version "
usage_error() { printf '%s (see: %s -help)\n' "$1" "$PROG" >&2; exit 3; }
set_command() {
  if [[ -n $COMMAND && $COMMAND != "$1" ]]; then usage_error "Only one command per run: -$COMMAND and -$1"; fi
  COMMAND=$1
}
while (( $# )); do
  case $1 in
    --) shift; ARGS+=("$@"); break ;;
    -*)
      sw=${1#-}; sw=${sw#-}; has_val=0; val=""
      if [[ $sw == *=* ]]; then val=${sw#*=}; sw=${sw%%=*}; has_val=1; fi
      case $sw in
        json)          JSON_OUT=1 ;;
        dry-run)       DRY_RUN=1 ;;
        v|verbose)     VERBOSE=1 ;;
        q|quiet)       QUIET=1 ;;
        force)         ARGS+=(--force) ;;
        config-file)
          if (( has_val )); then CONFIG_FILE=$val; else CONFIG_FILE=${2:-}; shift; fi
          [[ -n $CONFIG_FILE ]] || usage_error "-config-file needs a file name" ;;
        h|help)        set_command help ;;
        config)        set_command show-config ;;
        installautocomplete|install-autocomplete) set_command install-completion ;;
        *)
          if [[ $KNOWN_COMMANDS == *" $sw "* ]]; then set_command "$sw"
          else usage_error "Unknown switch: $1"; fi ;;
      esac ;;
    *)
      if [[ -z $COMMAND && $KNOWN_COMMANDS == *" $1 "* ]]; then COMMAND=$1
      else ARGS+=("$1"); fi ;;
  esac
  shift
done
COMMAND=${COMMAND:-help}

case $COMMAND in
  help) usage; exit 0 ;;
  version)
    if (( JSON_OUT )); then
      printf '{"tool":%s,"version":%s,"last_change":%s}\n' "$(jstr "$TOOL_NAME")" "$(jstr "$TOOL_VERSION")" "$(jstr "$TOOL_LAST_CHANGE")"
    else
      echo "$TOOL_NAME version $TOOL_VERSION"
      echo "Last change: $TOOL_LAST_CHANGE"
    fi
    exit 0 ;;
esac

trap finish EXIT
if [[ $COMMAND == cluster-ready ]]; then CONSOLE_OFF=1; NO_RUN_LOG_SUMMARY=1; fi
if [[ $COMMAND == logs || $COMMAND == runs || $COMMAND == monitor ]]; then NO_RUN_LOG=1; fi

set_defaults
CONFIG_LOADED="defaults"
if [[ $EUID -ne 0 ]]; then fail "Run as root (sudo $PROG -$COMMAND)"; fi
load_config
init_logging

if (( ! NO_RUN_LOG )); then
  log INFO run_start "Run started: $PROG $COMMAND ${ARGS[*]:-}" version="$VERSION" \
    args="${ARGS[*]:-}" user="${SUDO_USER:-root}" config="$CONFIG_FILE" config_source="$CONFIG_LOADED" \
    dry_run="$DRY_RUN" json="$JSON_OUT"
fi

if (( ! DRY_RUN )); then finish_log_migration; fi
if [[ $MUTATING_COMMANDS == *" $COMMAND "* ]]; then acquire_lock; fi

case $COMMAND in
  all)              cmd_all ;;
  validate)         cmd_validate ;;
  monitor)          cmd_monitor ;;
  monitor-enable)   cmd_monitor_enable ;;
  monitor-disable)  cmd_monitor_disable ;;
  install)          cmd_install ;;
  load-driver)      cmd_load_driver ;;
  iscsi-setup)      cmd_iscsi_setup ;;
  iscsi-test)       cmd_iscsi_test ;;
  troubleshoot)     cmd_troubleshoot ;;
  cluster-ready)    cmd_cluster_ready ;;
  multipath-config) cmd_multipath_config ;;
  rescan)           cmd_rescan ;;
  detect)           cmd_detect ;;
  identifiers)      cmd_identifiers ;;
  fc-status)        cmd_fc_status ;;
  status)           cmd_status ;;
  volumes)          cmd_volumes ;;
  verify)           cmd_verify ;;
  show-config)      cmd_show_config ;;
  init-config)      cmd_init_config ;;
  config-set)       cmd_config_set ;;
  alias-set)        cmd_alias_set ;;
  alias-remove)     cmd_alias_remove ;;
  logs)             cmd_logs ;;
  runs)             cmd_runs ;;
  install-completion) cmd_install_completion ;;
  *) EXIT_CODE=3; err_ "Unknown command '$COMMAND' (see: $PROG -help)" ;;
esac
