  esac
}

# ---------------------------------------------------------------------------
# Fencing
# ---------------------------------------------------------------------------
# Run fence_ipmilan (options on stdin) on node $1; sets FT_OUT FT_RC FT_MS
fence_try() {
  local m=$1 input=$2 t0
  t0=$(date +%s%N)
  if is_local "$m"; then FT_OUT=$(printf '%s\n' "$input" | fence_ipmilan 2>&1) && FT_RC=0 || FT_RC=$?
  else FT_OUT=$(ssh "${SSH_OPTS[@]}" "root@$m" "fence_ipmilan" <<<"$input" 2>&1) && FT_RC=0 || FT_RC=$?; fi
  FT_MS=$(( ($(date +%s%N) - t0) / 1000000 ))
}

act_addfence() {
  need_args 1 "Usage: $PROG -addfence node -ipaddr BMC_IP -user USER [-pass PASS]"
  require_running; load_state
  local node agent=${OPT[agent]:-fence_ipmilan} id pass params=()
  node=$(to_name "${ARGS[0]}")
  id="fence_$node"
  printf '%s\n' "${NODES[@]}" | grep -qx "$node" || die "$node is not in cluster $CL"
  res_exists "$id" && die "$id already exists (remove with -removefence $node)"

  if [ "$agent" = fence_ipmilan ]; then
    need_opt ipaddr; need_opt user
  fi
  if [ -n "${OPT[pass]:-}" ]; then pass=${OPT[pass]}
  elif [ -n "${FENCE_PASS:-}" ]; then pass=$FENCE_PASS
  elif [ -n "${OPT[ipaddr]:-}" ]; then pass=$(ask_secret "BMC password for $node")
  else pass=""; fi

  [ -n "${OPT[ipaddr]:-}" ] && params+=("ip=${OPT[ipaddr]}")
  [ -n "${OPT[user]:-}" ]   && params+=("username=${OPT[user]}")
  [ -n "$pass" ]            && params+=("password=$pass")
  if [ "$agent" = fence_ipmilan ] && ! ((NOLANPLUS)); then params+=("lanplus=1"); fi
  if [ -n "${OPT[params]:-}" ]; then local extra; read -ra extra <<<"${OPT[params]}"; params+=("${extra[@]}"); fi
  [ -n "${OPT[delay]:-}" ] && params+=("pcmk_delay_base=${OPT[delay]}")
  params+=("pcmk_host_list=$node")
  local cipher=${OPT[cipher]:-}
  [ -z "$cipher" ] || [[ $cipher =~ ^[0-9]+$ ]] || die "-cipher must be a number (IMM2: 3)"

  # The BMC address must be this node's own BMC (a swapped one fences the wrong server)
  if [ -n "${OPT[ipaddr]:-}" ] && ! ((DRYRUN)); then
    step "Checking that ${OPT[ipaddr]} is the BMC of $node"
    local bmcips bscript
    # shellcheck disable=SC2016
    bscript=$BMC_IP_SCRIPT
    bmcips=$(rq "$node" "$bscript" 2>/dev/null | paste -sd' ' || true)
    if [ -z "$bmcips" ]; then
      warn "Could not read the BMC address of $node (ipmitool) - make sure ${OPT[ipaddr]} is $node's own BMC"
    elif [[ " $bmcips " == *" ${OPT[ipaddr]} "* ]]; then
      msg "  [ OK ] ${OPT[ipaddr]} is the BMC of $node"
    elif ! ((FORCE)); then
      local other="" m
      for m in "${NODES[@]}"; do
        [ "$m" = "$node" ] && continue
        [[ " $(rq "$m" "$bscript" 2>/dev/null | paste -sd' ') " == *" ${OPT[ipaddr]} "* ]] && other=$m
      done
      die "${OPT[ipaddr]} is NOT the BMC of $node - $node's BMC is: $bmcips${other:+
${OPT[ipaddr]} belongs to $other.}
Fencing $node through another server's BMC would power off the wrong node. Use: -ipaddr ${bmcips%% *}"
    fi
  fi

  if [ "$agent" = fence_ipmilan ] && ! ((FORCE)) && ! ((DRYRUN)); then
    # The device for $node runs on the OTHER nodes: test from there
    local testers=() m input bad=0 ip=${OPT[ipaddr]}
    for m in "${NODES[@]}"; do [ "$m" = "$node" ] || testers+=("$m"); done
    ((${#testers[@]})) || testers=("$(hostname -s)")
    step "Testing BMC of $node ($ip) from: ${testers[*]}"
    input=$(printf 'ip=%s\nusername=%s\npassword=%s\naction=status\n' "$ip" "${OPT[user]}" "$pass")
    ((NOLANPLUS)) || input+=$'\nlanplus=1'
    [ -n "$cipher" ] && input+=$'\n'"cipher=$cipher"
    for m in "${testers[@]}"; do
      local net="" out rc dur out3 rc3 dur3
      if rq "$m" "ping -c 2 -W 2 $ip >/dev/null 2>&1" 2>/dev/null; then net="ping OK"; else net="no ping reply"; fi
      fence_try "$m" "$input"; out=$FT_OUT rc=$FT_RC dur=$FT_MS
      # slow or timed out with automatic cipher selection: try cipher suite 3
      if [ -z "$cipher" ] && ! ((NOLANPLUS)) && [ "$net" = "ping OK" ] && { ((rc != 0)) || ((dur > 8000)); }; then
        fence_try "$m" "$input"$'\n'"cipher=3"; out3=$FT_OUT rc3=$FT_RC dur3=$FT_MS
        if ((rc3 == 0)) && { ((rc != 0)) || ((dur3 * 2 < dur)); }; then
          printf '  [INFO] %s -> %s: automatic cipher %s, cipher 3 OK in %s s - using cipher=3\n' \
            "$m" "$ip" "$( ((rc == 0)) && echo "took $((dur / 1000)) s" || echo failed)" "$((dur3 / 1000))"
          cipher=3; input+=$'\n'"cipher=3"; out=$out3 rc=$rc3 dur=$dur3
        fi
      fi
      if ((rc == 0)); then
        printf '  [ OK ] %s -> %s: %s, login OK in %s s (%s)\n' "$m" "$ip" "$net" "$((dur / 1000))" "$(tail -1 <<<"$out")"
        ((dur > 15000)) && printf '  [WARN] the BMC answers slowly (%s s) - fencing timeouts are set for slow BMCs\n' "$((dur / 1000))"
        continue
      fi
      bad=1
      printf '  [FAIL] %s -> %s: %s, login failed: %s\n' "$m" "$ip" "$net" "$(grep -m1 -i 'error' <<<"$out" | sed 's/^[0-9 :,-]*//' || tail -1 <<<"$out")"
      if [ "$net" = "no ping reply" ]; then
        printf '         the BMC is not reachable from %s: BMC port not cabled, wrong port mode\n' "$m"
        printf '         (dedicated/shared), wrong IP/subnet on the BMC, or a VLAN/firewall between them\n'
      elif grep -qi 'timed out' <<<"$out"; then
        printf '         BMC answers ping but not IPMI (udp/623): enable "IPMI over LAN" on the BMC\n'
        printf '         (IMM/XCC web: Network -> Service Enablement), or try -nolanplus\n'
      else
        printf '         BMC answers, login refused: check user/password (on %s: ipmitool user list 1)\n' "$node"
      fi
    done
    ((bad == 0)) || die "BMC test failed for $node (use -force to create the device anyway)"
  fi

  [ -n "$cipher" ] && params+=("cipher=$cipher")
  step "Creating fence device $id ($agent${cipher:+, cipher $cipher})"
  # timeouts for slow BMCs; failure-timeout: one slow answer must not stop the device for good
  run pcs stonith create "$id" "$agent" "${params[@]}" pcmk_reboot_timeout=180s \
    op start timeout=60s op monitor interval=60s timeout=60s meta failure-timeout=120s
  run pcs constraint location "$id" avoids "$node"
  if ((${#NODES[@]} == 2)) && [ -z "${OPT[delay]:-}" ]; then
    msg "Tip: in a 2-node cluster give ONE node's fence device a delay (-delay 5s) to avoid fence races."
  fi
  local m missing=()
  for m in "${NODES[@]}"; do [ "$m" = "$node" ] || res_exists "fence_$m" || missing+=("$m"); done
  msg ""
  if ((${#missing[@]})); then
    msg "Still without fencing: ${missing[*]} - $PROG -addfence <node> -ipaddr <BMC IP> -user <user>"
  else
    msg "Every node has fencing. Next: $PROG -bmcstatus, then $PROG -setuplocking (shared storage)"
  fi
}

# BMC reachability and fencing readiness of each node, tested from the OTHER nodes
BX_OK=0 BX_WARN=0 BX_FAIL=0
bx_ok()   { msg "  [ OK ] $*"; BX_OK=$((BX_OK + 1)); }
bx_warn() { msg "  [WARN] $*"; BX_WARN=$((BX_WARN + 1)); }
bx_fail() { msg "  [FAIL] $*"; BX_FAIL=$((BX_FAIL + 1)); }

bmc_check() {
  local n m b fid fip user pass lanplus input out rc st running=0 testers
  BX_OK=0 BX_WARN=0 BX_FAIL=0
  crm_mon -1 >/dev/null 2>&1 && running=1
  declare -A BIP=()
  for n in "$@"; do BIP[$n]=$(rq "$n" "$BMC_IP_SCRIPT" 2>/dev/null | head -1 || true); done
  for n in "$@"; do
    b=${BIP[$n]} fid="fence_$n" fip=""
    if ((running)) && res_exists "$fid"; then fip=$(crm_resource -r "$fid" -g ip 2>/dev/null || true); fi
    if [ -z "$b" ]; then
      if [ -z "$fip" ]; then bx_fail "$n: BMC has no IP address (not configured) - see: $PROG -validate $n"; continue; fi
      bx_warn "$n: BMC address not readable on $n - using the fence device's address $fip"
      b=$fip
    fi
    if [ -n "$fip" ] && [ "$fip" != "$b" ]; then
      bx_fail "$n: $fid points to $fip, but the BMC of $n is $b - it would fence the wrong server"
    fi
    testers=()
    for m in "$@"; do [ "$m" = "$n" ] || testers+=("$m"); done
    ((${#testers[@]})) || testers=("$n")
    for m in "${testers[@]}"; do
      if ! rq "$m" "ping -c 2 -W 2 $b >/dev/null 2>&1" 2>/dev/null; then
        bx_fail "$n: BMC $b NOT reachable from $m - IMM port not connected, no link, or wrong IP/VLAN"
        continue
      fi
      bx_ok "$n: BMC $b reachable from $m"
      [ -n "$fip" ] || continue
      user=$(crm_resource -r "$fid" -g username 2>/dev/null || true)
      pass=$(crm_resource -r "$fid" -g password 2>/dev/null || true)
      lanplus=$(crm_resource -r "$fid" -g lanplus 2>/dev/null || true)
      local cph; cph=$(crm_resource -r "$fid" -g cipher 2>/dev/null || true)
      input=$(printf 'ip=%s\nusername=%s\npassword=%s\naction=status\n' "$fip" "$user" "$pass")
      [ -n "$lanplus" ] && input+=$'\n'"lanplus=$lanplus"
      [ -n "$cph" ] && input+=$'\n'"cipher=$cph"
      fence_try "$m" "$input"; out=$FT_OUT rc=$FT_RC
      if ((rc == 0)); then
        bx_ok "$n: $fid can log in from $m in $((FT_MS / 1000)) s ($(tail -1 <<<"$out"))"
        if ((FT_MS > 15000)); then bx_warn "$n: the BMC answers slowly ($((FT_MS / 1000)) s)${cph:+ even with cipher $cph} - fence operations may time out"
        elif ((FT_MS > 8000)) && [ -z "$cph" ]; then bx_warn "$n: login is slow ($((FT_MS / 1000)) s) - re-create the device: $PROG -removefence $n; $PROG -addfence $n ... (detects a faster cipher)"; fi
      else bx_fail "$n: $fid cannot log in to $fip from $m - IPMI over LAN off, or user/password changed"; fi
    done
    if ((running)); then
      if [ -z "$fip" ]; then
        bx_warn "$n: no fence device - $PROG -addfence $n -ipaddr $b -user USERID"
      else
        st=$(crm_resource -r "$fid" --locate 2>&1 || true)
        if [[ $st == *"is running on"* ]]; then bx_ok "$n: $fid started"
        else
          bx_fail "$n: $fid is not running"
          local why
          why=$(crm_mon -1 2>/dev/null | grep -m1 "${fid}_" | sed 's/^ *\* *//' || true)
          [ -n "$why" ] && msg "         last failure: $why"
          msg "         fix: $PROG -cleanup $fid   (devices made before 1.17.0: re-create with -removefence/-addfence)"
        fi
      fi
    fi
  done
  if ((running)); then
    local pend
    pend=$(stonith_admin --history '*' 2>/dev/null | grep -i 'pending' || true)
    [ -n "$pend" ] && bx_warn "stale pending fence action(s): $(head -1 <<<"$pend" | sed 's/^ *\* *//') - clear: pcs stonith history cleanup"
  fi
  return 0
}

act_bmcstatus() {
  require_cluster
  local nodes n
  if ((${#ARGS[@]})) || [ -n "${OPT[nodes]:-}" ]; then mapfile -t nodes < <(target_nodes)
  else nodes=("${NODES[@]}"); fi
  for n in "${nodes[@]}"; do ssh_check "$n"; done
  msg "BMC (IMM) status - each BMC is tested from the other nodes"
  bmc_check "${nodes[@]}"
  echo
  if ((BX_FAIL > 0)); then msg "BMC: $BX_OK OK, $BX_WARN warning(s), $BX_FAIL FAILED"
  elif ((BX_WARN > 0)); then msg "BMC: $BX_OK OK, $BX_WARN warning(s) - fencing not complete"
  else msg "BMC: all $BX_OK checks OK - fencing ready"; fi
  ((BX_FAIL == 0))
}

