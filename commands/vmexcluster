set -euo pipefail

VERSION="1.21.0"
PROG=$(basename "$0")
SELF=$(readlink -f "$0")
REMOTE_BIN=/usr/local/sbin/vmexcluster
COMPLETION_NAME=vmexcluster.bash-completion
COMPLETION_DEST=/usr/share/bash-completion/completions/vmexcluster
CONF_DIR=/etc/vmexcluster
STATE_FILE=$CONF_DIR/cluster.conf
VM_DIR=/etc/pacemaker/vms
COROSYNC_CONF=/etc/corosync/corosync.conf
LOG_DIR=${VMEX_LOG_DIR:-/var/log/vmex/vmexcluster}
HAPASS_DIR=/opt/VMX-10.0.0/vmx-files/vmexcluster
HAPASS_FILE=${VMEX_HAPASS_FILE:-$HAPASS_DIR/hacluster}
AUTH_SHOW="/************"          # shown instead of the file path
# prints the BMC IP address(es) of the node it runs on
# shellcheck disable=SC2016
BMC_IP_SCRIPT='modprobe -qa ipmi_devintf ipmi_si 2>/dev/null; for c in 1 2 8; do ipmitool lan print $c 2>/dev/null; done | awk -F": " "/^IP Address +:/ {print \$2}" | grep -v "^0\.0\.0\.0$" | sort -u'
HISTORY=$LOG_DIR/history.log
ARCHIVE_MAX_RELEASE=42      # Fedora releases at or below this use the archive
ARCHIVE=https://archives.fedoraproject.org/pub/archive/fedora/linux
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)
WAIT=180

DEF_VG=vg_shared
DEF_LV=lv_vmstore
DEF_MOUNT=/vmstore
DEF_FSNAME=vmstore
DEF_SIZE=100%FREE
DEF_PREFIX=node
