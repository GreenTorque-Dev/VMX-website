act_iscsilogin() {
  need_opt portal
  local nodes n sel s
  mapfile -t nodes < <(target_nodes)
  sel="-p $(printf %q "${OPT[portal]}")"
  [ -n "${OPT[target]:-}" ] && sel+=" -T $(printf %q "${OPT[target]}")"
  s="set -e
iscsiadm -m discovery -t sendtargets -p $(printf %q "${OPT[portal]}")"
  if [ -n "${OPT[chapuser]:-}" ]; then
    s+="
iscsiadm -m node $sel --op update -n node.session.auth.authmethod -v CHAP
iscsiadm -m node $sel --op update -n node.session.auth.username -v $(printf %q "${OPT[chapuser]}")
iscsiadm -m node $sel --op update -n node.session.auth.password -v $(printf %q "${OPT[chappass]:-}")"
  fi
  s+="
iscsiadm -m node $sel --op update -n node.startup -v automatic
iscsiadm -m node $sel --login || true
multipath -r >/dev/null 2>&1 || true
sleep 2
multipath -ll"
  for n in "${nodes[@]}"; do
    step "iSCSI login on $n"
    ssh_check "$n"
    rsh "$n" "$s"
  done
}

act_iscsilogout() {
  need_opt portal
  local nodes n sel s
  mapfile -t nodes < <(target_nodes)
  sel="-p $(printf %q "${OPT[portal]}")"
  [ -n "${OPT[target]:-}" ] && sel+=" -T $(printf %q "${OPT[target]}")"
  confirm "Log out of iSCSI ${OPT[target]:-all targets} at ${OPT[portal]} on: ${nodes[*]}? Make sure nothing uses these disks."
  s="iscsiadm -m node $sel --logout || true"
  ((PURGE)) && s+="; iscsiadm -m node $sel --op delete || true"
  for n in "${nodes[@]}"; do step "iSCSI logout on $n"; ssh_check "$n"; rsh "$n" "$s"; done
}

act_listdisks() {
  local nodes n
  mapfile -t nodes < <(target_nodes)
  for n in "${nodes[@]}"; do
    step "Disks on $n"
    ssh_check "$n"
    rq "$n" "echo '# iSCSI sessions'; iscsiadm -m session 2>/dev/null || echo none
echo; echo '# Multipath devices (name (WWID) dm-N vendor,product)'; multipath -ll 2>/dev/null || true
echo; lsblk -o NAME,SIZE,TYPE,WWN,MOUNTPOINTS"
  done
}

act_mpathalias() {
  need_opt wwid; need_opt alias
  local nodes n file content
  if ((${#ARGS[@]} == 0)) && [ -z "${OPT[nodes]:-}" ] && [ -f "$COROSYNC_CONF" ]; then
    require_cluster; nodes=("${NODES[@]}")      # same name on every node
  else
    mapfile -t nodes < <(target_nodes)
  fi
  [[ ${OPT[alias]} =~ ^[A-Za-z0-9_-]+$ ]] || die "Alias: letters, digits, _ and - only"
  file=/etc/multipath/conf.d/vmexcluster-${OPT[alias]}.conf
  content="multipaths {
    multipath {
        wwid ${OPT[wwid]}
        alias ${OPT[alias]}
    }
}"
  for n in "${nodes[@]}"; do
    step "Multipath alias ${OPT[alias]} -> ${OPT[wwid]} on $n"
    ssh_check "$n"
    if ((DRYRUN)) || rq "$n" "command -v vmexsanconnect >/dev/null 2>&1" 2>/dev/null; then
      # vmexsanconnect manages /etc/multipath.conf: let it set the alias
      rsh "$n" "rm -f $file; vmexsanconnect -alias-set $(printf %q "${OPT[wwid]}") $(printf %q "${OPT[alias]}")"
      continue
    fi
    rsh "$n" "mkdir -p /etc/multipath/conf.d
printf '%s\n' $(printf %q "$content") > $file
multipath -a /dev/disk/by-id/dm-uuid-mpath-${OPT[wwid]} >/dev/null 2>&1 || true
multipathd reconfigure >/dev/null 2>&1 || systemctl reload multipathd
sleep 2
ls -l /dev/mapper/${OPT[alias]} || echo 'Device not visible yet - check: multipath -ll'"
  done
}

# ---------------------------------------------------------------------------
# Shared storage through vmexsp
# ---------------------------------------------------------------------------
vmexsp_shared_vg() {
  local v
  v=$(sed -n 's/^[[:space:]]*SHARED_VG[[:space:]]*=[[:space:]]*["'\'']\{0,1\}\([A-Za-z0-9_.+-]*\).*/\1/p' /etc/vmexsp.conf 2>/dev/null | tail -1)
  echo "${v:-sharedvg}"
}

# The vmexsp steps for a shared pool, with this cluster's node names and SAN device
shared_hint() {
  local devs d me others=()
  devs=$(lsblk -npro NAME,TYPE 2>/dev/null | awk '$2 == "mpath" {print $1}' | sort -u | paste -sd' ' || true)
  d=${devs%% *}; [ -n "$d" ] || d="/dev/mapper/<SAN volume>"
  me=$(hostname -s)
  [ -n "${NODES[*]:-}" ] || mapfile -t NODES < <(cluster_nodes)
  for n in "${NODES[@]}"; do [ "$n" = "$me" ] || others+=("$n"); done
  msg "Shared storage pool (vmexsp), in this order:"
  msg "  1. on $me:  vmexsp -shared-init $d        (WIPES the SAN volume, creates $(vmexsp_shared_vg))"
  ((${#others[@]})) && msg "  2. on ${others[*]}:  vmexsp -shared-join $d"
  msg "  3. on $me:  vmexsp -create <Name> [size] -shared   (e.g. vmexsp -create Finance 2T -shared)"
  ((${#others[@]})) && msg "  4. on ${others[*]}:  vmexsp -sync"
  [[ $devs == *" "* ]] && msg "  (SAN volumes on this node: $devs)"
  return 0
}

setup_locking() {
  step "Cluster property for GFS2"
  run pcs property set no-quorum-policy=freeze
  step "DLM and lvmlockd (locking-clone on all nodes)"
  if res_exists locking-clone; then
    msg "locking-clone already exists"
  else
    run pcs resource create dlm ocf:pacemaker:controld op monitor interval=30s on-fail=fence --disabled
    run pcs resource create lvmlockd ocf:heartbeat:lvmlockd op monitor interval=30s on-fail=fence --disabled
    run pcs resource group add locking dlm lvmlockd
    run pcs resource clone locking meta interleave=true
    run pcs resource enable dlm lvmlockd
    wait_settle
  fi
}

act_setuplocking() {
  require_running
  local n bad=0 st
  if ! ((DRYRUN)); then
    pcs stonith status 2>/dev/null | grep -q Started || \
      die "No fence device is running - shared storage needs fencing first: $PROG -addfence ... ; $PROG -bmcstatus"
    for n in "${NODES[@]}"; do
      rq "$n" "lvmconfig --typeconfig full global/use_lvmlockd 2>/dev/null | tr -d ' ' | grep -qx use_lvmlockd=1" 2>/dev/null || \
        die "use_lvmlockd = 1 is not set on $n - run: $PROG -installprereq $n"
    done
  fi
  setup_locking
  if ! ((DRYRUN)); then
    st=$(crm_resource -r locking-clone --locate 2>&1 || true)
    for n in "${NODES[@]}"; do
      if grep -q "running on: $n\b" <<<"$st"; then msg "  [ OK ] dlm and lvmlockd running on $n"
      else msg "  [FAIL] dlm and lvmlockd NOT running on $n"; bad=1; fi
    done
    ((bad == 0)) || die "locking-clone is not running everywhere - check: $PROG -status ; $PROG -cleanup locking-clone"
  fi
  msg ""
  if command -v vmexsp >/dev/null 2>&1; then shared_hint
  else msg "Next: shared storage - install vmexsp, or: $PROG -setupstorage -device /dev/mapper/<SAN volume>"; fi
}

act_setupstorage() {
  need_opt device
  require_running
  if command -v vmexsp >/dev/null 2>&1 && ! ((FORCE)); then
    msg "vmexsp is installed: it manages all storage pools (storage01 local, storage02 shared ...,"
    msg "one numbering, libvirt pools on every node). Create the shared pool with vmexsp:"
    msg ""
    res_exists locking-clone || msg "First: $PROG -setuplocking"
    shared_hint
    die "Use vmexsp for shared storage (-force uses $PROG's own GFS2 setup, which vmexsp does not know)"
  fi
  load_state
  [ -z "$SHARED_DEV" ] || ((FORCE)) || die "Shared storage already configured on $SHARED_DEV ($MOUNT). Use -removestorage first."
  local dev=${OPT[device]} size=${OPT[size]:-$DEF_SIZE} mnt=${OPT[mount]:-} vg lv fs j n num nn used
  # Storage name: next /storages/storageNN free on every node (storage01 = local storage)
  if [ -z "$mnt" ]; then
    for ((num = 1; num < 100; num++)); do
      nn=$(printf '%02d' "$num"); mnt=$STORAGES_DIR/storage$nn; used=0
      for n in "${NODES[@]}"; do
        rq "$n" "test -e $mnt || grep -qs ' $mnt ' /proc/mounts" 2>/dev/null && { used=1; break; }
      done
      ((used)) || break
    done
    msg "Storage name: storage$nn -> $mnt (next free on ${NODES[*]})"
  fi
  if [[ $mnt =~ /storage([0-9]+)$ ]]; then
    nn=${BASH_REMATCH[1]}
    vg=${OPT[vg]:-storagevg$nn} lv=${OPT[lv]:-storage$nn} fs=${OPT[fsname]:-storage$nn}
  else
    vg=${OPT[vg]:-$DEF_VG} lv=${OPT[lv]:-$DEF_LV} fs=${OPT[fsname]:-$DEF_FSNAME}
  fi
  j=${OPT[journals]:-${#NODES[@]}}; ((j < 2)) && j=2
  valid_id "$vg"; valid_id "$lv"; valid_id "$fs"
  ((${#fs} <= 30)) || die "-fsname must be at most 30 characters"
  [[ $mnt == /* ]] || die "-mount must be an absolute path"
  for n in "${NODES[@]}"; do
    if rq "$n" "vgs --noheadings -o vg_name 2>/dev/null | awk '{print \$1}' | grep -qx $(printf %q "$vg")" 2>/dev/null; then
      die "Volume group '$vg' already exists on $n - give another name with -vg"
    fi
    if rq "$n" "grep -qs ' $mnt ' /proc/mounts || [ -n \"\$(ls -A $(printf %q "$mnt") 2>/dev/null)\" ]" 2>/dev/null; then
      die "$mnt is mounted or not empty on $n - choose another -mount"
    fi
  done

  for n in "${NODES[@]}"; do
    ssh_check "$n"
    ((DRYRUN)) || rq "$n" "test -b $(printf %q "$dev")" || \
      die "$dev not present on $n (run -iscsilogin / -mpathalias on all nodes)"
  done
  # SAN must be ready on every node (vmexsanconnect)
  local srout srrc notready=()
  step "SAN readiness (vmexsanconnect -cluster-ready) on: ${NODES[*]}"
  for n in "${NODES[@]}"; do
    srout=$(rq "$n" "$SAN_READY_SCRIPT" 2>&1) && srrc=0 || srrc=$?
    case $srrc in
      0) msg "  [ OK ] $n: Ready for vmex cluster" ;;
      2) msg "  [WARN] $n: vmexsanconnect not installed - not checked" ;;
      *) msg "  [FAIL] $n: platform is NOT ready for vmex cluster"
         grep -E '\[ ?(FAIL|WARN|ERROR)|ERROR|not ready' <<<"$srout" | head -5 | sed 's/^[[:space:]]*/         /' || true
         notready+=("$n") ;;
    esac
  done
  if ((${#notready[@]})) && ! ((FORCE)) && ! ((DRYRUN)); then
    die "SAN not ready on: ${notready[*]} - nothing was changed. Fix it (vmexsanconnect -cluster-ready), or use -force"
  fi

  # Existing data on the LUN? (read-only checks)
  local has_data=0 sigs parts
  for n in "${NODES[@]}"; do
    if rq "$n" "lsblk -nr -o MOUNTPOINTS $(printf %q "$dev") 2>/dev/null | grep -q ." 2>/dev/null; then
      die "Something on $dev is MOUNTED on $n - unmount it first:
$(rq "$n" "lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS $(printf %q "$dev")" 2>/dev/null)"
    fi
  done
  parts=$(lsblk -nr -o TYPE "$dev" 2>/dev/null | grep -c '^part$' || true)
  sigs=$(wipefs --no-act --noheadings --output TYPE "$dev" 2>/dev/null | paste -sd, || true)
  if ((parts > 0)) || [ -n "$sigs" ]; then
    has_data=1
    msg ""
    msg "$dev is NOT empty:"
    [ -n "$sigs" ] && msg "  signatures: $sigs"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,PARTLABEL "$dev" 2>/dev/null | sed 's/^/  /'
    if ! ((WIPE)); then
      die "The LUN contains partitions or data (above). Make sure nothing on it is needed,
then run the same command with -wipe to erase it."
    fi
  fi
  confirm "ALL DATA on $dev will be destroyed$( ((has_data)) && echo " (existing partitions/data shown above will be wiped)").
Creating: VG $vg (shared) -> LV $lv ($size) -> GFS2 $CL:$fs ($j journals) mounted at $mnt on: ${NODES[*]}" "$dev"

  if ((has_data)); then
    local unmap
    # remove partition mappings: on the multipath device and on its path devices
    unmap="d=$(printf %q "$dev"); kpartx -d \"\$d\" >/dev/null 2>&1 || true
dm=\$(basename \"\$(readlink -f \"\$d\")\")
for s in /sys/block/\$dm/slaves/*; do [ -e \"\$s\" ] && partx -d \"/dev/\$(basename \"\$s\")\" >/dev/null 2>&1; done
udevadm settle 2>/dev/null; true"
    step "Erasing the existing partitions and signatures on $dev"
    for n in "${NODES[@]}"; do rsh "$n" "$unmap"; msg "  $n: partition maps removed"; done
    run wipefs -a "$dev"
    for n in "${NODES[@]}"; do
      rsh "$n" "$unmap; multipath -r >/dev/null 2>&1; udevadm settle 2>/dev/null; true"
    done
    if ! ((DRYRUN)); then
      for n in "${NODES[@]}"; do
        parts=$(rq "$n" "lsblk -nr -o TYPE $(printf %q "$dev") | grep -c '^part\$' || true" 2>/dev/null || echo "?")
        [ "$parts" = 0 ] || die "$n still sees partitions on $dev - reboot $n (or run partx -d on its path devices), then run this again"
        msg "  [ OK ] $n: $dev is empty"
      done
    fi
  fi

  setup_locking

  step "Registering $dev in the LVM devices file on all nodes"
  for n in "${NODES[@]}"; do
    rsh "$n" "lvmdevices --adddev $(printf %q "$dev") 2>/dev/null || true"
  done

  step "Shared volume group $vg"
  run vgcreate --yes --shared "$vg" "$dev"
  for n in "${NODES[@]}"; do
    is_local "$n" && continue
    rrun "$n" vgchange --lockstart "$vg"
  done

  step "Logical volume $lv"
  if [[ $size == *%* ]]; then run lvcreate --yes --activate sy -l "$size" -n "$lv" "$vg"
  else run lvcreate --yes --activate sy -L "$size" -n "$lv" "$vg"; fi

  step "GFS2 file system $CL:$fs"
  run mkfs.gfs2 -O -j "$j" -p lock_dlm -t "$CL:$fs" "/dev/$vg/$lv"

  step "Mount point $mnt on all nodes"
  for n in "${NODES[@]}"; do
    rsh "$n" "mkdir -p $(printf %q "$mnt"); semanage fcontext -l | grep -q '^$mnt(/\.\*)?' || semanage fcontext -a -t virt_image_t '$mnt(/.*)?'"
  done

  step "Cluster resources for the shared file system"
  run pcs resource create "${lv}-lv" ocf:heartbeat:LVM-activate \
    vgname="$vg" lvname="$lv" activation_mode=shared vg_access_mode=lvmlockd --disabled
  run pcs resource create "${fs}-fs" ocf:heartbeat:Filesystem \
    device="/dev/$vg/$lv" directory="$mnt" fstype=gfs2 options=noatime \
    op monitor interval=10s on-fail=fence --disabled
  run pcs resource group add "$vg" "${lv}-lv" "${fs}-fs"
  run pcs resource clone "$vg" meta interleave=true
  run pcs constraint order start locking-clone then "${vg}-clone"
  run pcs constraint colocation add "${vg}-clone" with locking-clone
  run pcs resource enable "${lv}-lv" "${fs}-fs"
  wait_settle

  if ! ((DRYRUN)) && mountpoint -q "$mnt"; then run restorecon -R "$mnt"; fi

  CLUSTER=$CL SHARED_DEV=$dev VG=$vg LV=$lv MOUNT=$mnt FSNAME=$fs JOURNALS=$j
  save_state; push_state
  msg ""
  msg "Shared storage ready: $mnt (GFS2) on ${NODES[*]}. Check: $PROG -storagestatus"
}

act_addjournal() {
  need_args 1 "Usage: $PROG -addjournal N"
  require_running; load_state
  [ -n "$MOUNT" ] || die "No shared storage configured"
  [[ ${ARGS[0]} =~ ^[1-9][0-9]*$ ]] || die "N must be a positive number"
  ((DRYRUN)) || mountpoint -q "$MOUNT" || die "$MOUNT is not mounted on this node"
  run gfs2_jadd -j "${ARGS[0]}" "$MOUNT"
  JOURNALS=$(( JOURNALS + ARGS[0] )); save_state; push_state
  msg "GFS2 journals: $JOURNALS"
}

act_storagestatus() {
  require_cluster; load_state
  [ -n "$VG" ] || { msg "No shared storage configured (see -setupstorage)"; return 0; }
  msg "Device: $SHARED_DEV  VG: $VG  LV: $LV  FS: $CL:$FSNAME  Mount: $MOUNT  Journals: $JOURNALS"
  echo; pcs resource status locking-clone 2>/dev/null || true
  pcs resource status "${VG}-clone" 2>/dev/null || true
  local n
  echo
  for n in "${NODES[@]}"; do
    printf '%-20s ' "$n"
    rq "$n" "if mountpoint -q $(printf %q "$MOUNT"); then df -hP $(printf %q "$MOUNT") | awk 'NR==2{print \"mounted  size \"\$2\"  used \"\$3\" (\"\$5\")  free \"\$4}'; else echo 'NOT mounted'; fi" 2>/dev/null || echo "unreachable"
  done
  ((${#NODES[@]} > JOURNALS)) && warn "More nodes (${#NODES[@]}) than GFS2 journals ($JOURNALS): $PROG -addjournal $(( ${#NODES[@]} - JOURNALS ))"
  return 0
}

act_removestorage() {
  require_running; load_state
  [ -n "$VG" ] || die "No shared storage configured"
  local vms
  vms=$(ls "$VM_DIR"/*.xml 2>/dev/null | wc -l)
  ((vms == 0)) || ((FORCE)) || die "$vms clustered VM(s) still defined. Remove them first (or use -force)"
  confirm "Unmount $MOUNT on all nodes and delete its cluster resources? Data on $SHARED_DEV is kept." "$VG"
  run pcs resource disable "${VG}-clone" --wait="$WAIT"
  run pcs resource delete "${FSNAME}-fs"
  run pcs resource delete "${LV}-lv"
  SHARED_DEV="" VG="" LV="" MOUNT="" FSNAME="" JOURNALS=0
  save_state; push_state
  msg "Storage resources removed. dlm/lvmlockd (locking-clone) kept. Delete with: pcs resource delete locking"
}

# ---------------------------------------------------------------------------
# Virtual machines
# ---------------------------------------------------------------------------
push_vm_xml() {
  local vm=$1 n
  for n in "${NODES[@]}"; do
    is_local "$n" && continue
    rrun "$n" mkdir -p "$VM_DIR"
    rcopy "$VM_DIR/$vm.xml" "$n" "$VM_DIR/$vm.xml"
  done
}

act_addvm() {
  need_args 1 "Usage: $PROG -addvm vm [vm ...] [-xml FILE] [-prefer node]"
  require_running; load_state
  [ -n "${OPT[prefer]:-}" ] && OPT[prefer]=$(to_name "${OPT[prefer]}")
  [ -n "${OPT[xml]:-}" ] && ((${#ARGS[@]} > 1)) && die "-xml can only be used with one VM"
  local vm n xml f state mnt=${MOUNT:-$DEF_MOUNT} i
  for vm in "${ARGS[@]}"; do
    step "=== Adding VM $vm ==="
    valid_id "$vm"
    res_exists "$vm" && die "Resource $vm already exists"
    xml=$VM_DIR/$vm.xml
    run mkdir -p "$VM_DIR"

    if [ -n "${OPT[xml]:-}" ]; then
      [ -f "${OPT[xml]}" ] || die "${OPT[xml]} not found"
      run cp -f "${OPT[xml]}" "$xml"
    else
      virsh dominfo "$vm" >/dev/null 2>&1 || die "VM $vm is not defined on this node (or use -xml FILE)"
      if ((DRYRUN)); then msg "[dry-run] virsh dumpxml --inactive --security-info $vm > $xml"
      else virsh dumpxml --inactive --security-info "$vm" > "$xml"; fi
    fi

    local fsres=() id r
    if [ -f "$xml" ]; then
      while read -r f; do
        id=""; [[ $f =~ ^$STORAGES_DIR/([^/]+)/ ]] && id=${BASH_REMATCH[1]}
        if [ "$(findmnt -n -o FSTYPE --target "$f" 2>/dev/null)" != gfs2 ]; then
          warn "$vm disk $f is NOT on shared (GFS2) storage - migration/failover will fail"
          continue
        fi
        # the cluster resource that mounts this pool: the VM must start after it
        if [ -n "$id" ] && res_exists "vmexsp-$id-fs-clone"; then fsres+=("vmexsp-$id-fs-clone")
        elif [ -n "$VG" ] && [[ $f == "$mnt"/* ]]; then fsres+=("${VG}-clone"); fi
      done < <(grep -oP "<source file=['\"]\K[^'\"]+" "$xml" || true)
    fi

    step "Removing $vm from libvirt on every node (the cluster owns it now)"
    for n in "${NODES[@]}"; do
      ((DRYRUN)) && { msg "[dry-run][$n] shut down / undefine $vm if defined"; continue; }
      state=$(rq "$n" "virsh domstate $(printf %q "$vm") 2>/dev/null" || true)
      [ -z "$state" ] && continue
      if [[ $state == running* || $state == paused* ]]; then
        is_local "$n" || die "$vm is running on $n - shut it down there first"
        msg "Shutting down $vm on $n..."
        virsh shutdown "$vm" >/dev/null || true
        for ((i = 0; i < WAIT; i += 5)); do
          [[ $(virsh domstate "$vm" 2>/dev/null) == "shut off" ]] && break; sleep 5
        done
        [[ $(virsh domstate "$vm" 2>/dev/null) == "shut off" ]] || die "$vm did not shut down in ${WAIT}s"
      fi
      rsh "$n" "virsh undefine --keep-nvram $(printf %q "$vm") >/dev/null 2>&1 || virsh undefine $(printf %q "$vm")"
    done

    push_vm_xml "$vm"

    step "Creating cluster resource $vm"
    local meta=(allow-migrate=true)
    ((NOMIGRATE)) && meta=(allow-migrate=false)
    run pcs resource create "$vm" ocf:heartbeat:VirtualDomain \
      config="$xml" hypervisor=qemu:///system migration_transport=ssh \
      meta "${meta[@]}" \
      op start timeout=120s op stop timeout=180s \
      op monitor interval=10s timeout=30s \
      op migrate_to timeout=180s op migrate_from timeout=180s --disabled
    for r in $(printf '%s\n' "${fsres[@]}" | sort -u); do
      run pcs constraint order start "$r" then "$vm"
      run pcs constraint colocation add "$vm" with "$r"
    done
    [ -n "${OPT[prefer]:-}" ] && run pcs constraint location "$vm" prefers "${OPT[prefer]}"
    if ((NOSTART)); then msg "$vm created (stopped). Start with: $PROG -startvm $vm"
    else run pcs resource enable "$vm" --wait="$WAIT"; fi
  done
}

act_removevm() {
  need_args 1 "Usage: $PROG -removevm vm [-purge]"
  require_running
  local vm n
  for vm in "${ARGS[@]}"; do
    res_exists "$vm" || ((DRYRUN)) || die "No cluster resource $vm"
    if ((PURGE)); then
      confirm "Stop $vm and remove it from the cluster and all VM definitions? (disk images are kept)" "$vm"
    else
      confirm "Stop $vm and remove it from the cluster? It will be re-defined (stopped) in libvirt on $(hostname -s)."
    fi
    run pcs resource disable "$vm" --wait="$WAIT"
    run pcs resource delete "$vm"
    if ! ((PURGE)) && [ -f "$VM_DIR/$vm.xml" ]; then run virsh define "$VM_DIR/$vm.xml"; fi
    for n in "${NODES[@]}"; do rrun "$n" rm -f "$VM_DIR/$vm.xml" || true; done
  done
}

act_startvm()   { need_args 1 "Usage: $PROG -startvm vm ...";   require_running; local v; for v in "${ARGS[@]}"; do run pcs resource enable "$v" --wait="$WAIT"; done; }
act_stopvm()    { need_args 1 "Usage: $PROG -stopvm vm ...";    require_running; local v; for v in "${ARGS[@]}"; do run pcs resource disable "$v" --wait="$WAIT"; done; }
act_restartvm() { need_args 1 "Usage: $PROG -restartvm vm ..."; require_running; local v; for v in "${ARGS[@]}"; do run pcs resource restart "$v" --wait="$WAIT"; done; }
act_clearvm()   { need_args 1 "Usage: $PROG -clearvm vm ...";   require_running; local v; for v in "${ARGS[@]}"; do run pcs resource clear "$v"; done; }

act_migratevm() {
  need_args 1 "Usage: $PROG -migratevm vm [-to node]"
  require_running; load_state
  [ -n "${OPT[to]:-}" ] && OPT[to]=$(to_name "${OPT[to]}")
  local vm
  for vm in "${ARGS[@]}"; do
    if [ -n "${OPT[to]:-}" ]; then run pcs resource move "$vm" "${OPT[to]}" --wait="$WAIT"
    else run pcs resource move "$vm" --wait="$WAIT"; fi
  done
}

act_listvms() {
  require_cluster
  local ids id
  mapfile -t ids < <(cibadmin --query --scope resources 2>/dev/null \
    | grep -oP '<primitive [^>]*type="VirtualDomain"[^>]*>' | grep -oP ' id="\K[^"]+' | sort)
  ((${#ids[@]})) || { msg "No clustered VMs (add with: $PROG -addvm <vm>)"; return 0; }
  printf '%-25s %s\n' "VM" "STATUS"
  for id in "${ids[@]}"; do
    printf '%-25s %s\n' "$id" "$(crm_resource --resource "$id" --locate 2>&1 | sed 's/^resource [^ ]* //' | paste -sd ';')"
  done
}

act_vmstatus() {
  need_args 1 "Usage: $PROG -vmstatus vm"
  require_cluster
  local vm=${ARGS[0]}
  pcs resource status "$vm" || true; echo
  pcs resource config "$vm" || true; echo
  pcs constraint ref "$vm" || true; echo
  crm_resource --resource "$vm" --locate || true
}

act_syncvm() {
  require_cluster
  local vms=() vm f
  if [ -n "${OPT[xml]:-}" ]; then
    need_args 1 "Usage: $PROG -syncvm vm -xml FILE"
    [ -f "${OPT[xml]}" ] || die "${OPT[xml]} not found"
    run cp -f "${OPT[xml]}" "$VM_DIR/${ARGS[0]}.xml"
  fi
  if ((${#ARGS[@]})); then vms=("${ARGS[@]}")
  else for f in "$VM_DIR"/*.xml; do [ -e "$f" ] && vms+=("$(basename "$f" .xml)"); done; fi
  ((${#vms[@]})) || die "No VM definitions in $VM_DIR"
  for vm in "${vms[@]}"; do
    [ -f "$VM_DIR/$vm.xml" ] || ((DRYRUN)) || die "$VM_DIR/$vm.xml not found"
    step "Syncing $vm"
    push_vm_xml "$vm"
  done
  msg "Changes take effect on next VM start: $PROG -restartvm <vm>"
}

