act_verify()  { require_cluster; pcs cluster verify --full; msg "Configuration OK"; }
act_cleanup() { require_running; if ((${#ARGS[@]})); then run pcs resource cleanup "${ARGS[@]}"; else run pcs resource cleanup; fi; }
act_config()  { require_cluster; pcs config; echo; load_state; msg "# vmexcluster state ($STATE_FILE)"; cat "$STATE_FILE" 2>/dev/null || true; }

act_backup() {
  require_cluster
  local base=${ARGS[0]:-/root/vmexcluster-${CL}-$(date +%Y%m%d-%H%M)}
  base=${base%.tar.bz2}
  run pcs config backup "$base"
  run tar czf "${base}-vms.tar.gz" -C / "${CONF_DIR#/}" "${VM_DIR#/}"
  msg "Backup: ${base}.tar.bz2 (cluster config) and ${base}-vms.tar.gz (VM definitions)"
}

act_restore() {
  need_args 1 "Usage: $PROG -restore file.tar.bz2"
  local file=${ARGS[0]} vms
  [ -f "$file" ] || die "$file not found"
  if ! ((DRYRUN)) && crm_mon -1 >/dev/null 2>&1; then
    die "Stop the cluster on all nodes first: $PROG -stop"
  fi
  confirm "Overwrite the cluster configuration on all nodes with $file?"
  run pcs config restore "$file"
  vms="${file%.tar.bz2}-vms.tar.gz"
  if [ -f "$vms" ]; then
    run tar xzf "$vms" -C /
    mapfile -t NODES < <(cluster_nodes)
    local n f
    for n in "${NODES[@]}"; do
      is_local "$n" && continue
      rrun "$n" mkdir -p "$VM_DIR" "$CONF_DIR"
      [ -f "$STATE_FILE" ] && rcopy "$STATE_FILE" "$n" "$STATE_FILE"
      for f in "$VM_DIR"/*.xml; do [ -e "$f" ] && rcopy "$f" "$n" "$f"; done
    done
  fi
  msg "Restored. Start the cluster with: $PROG -start"
}

act_report() {
  require_cluster
  local dest=${ARGS[0]:-/root/vmexcluster-report-$(date +%Y%m%d-%H%M)}
  local since=${OPT[since]:-$(date -d '-2 hours' '+%Y-%m-%d %H:%M')}
  run pcs cluster report --from "$since" "$dest"
}

act_history() {
  local n=${ARGS[0]:-${OPT[lines]:-30}}
  [[ $n =~ ^[0-9]+$ ]] || die "Usage: $PROG -history [N]"
  [ -f "$HISTORY" ] || { msg "No history yet ($HISTORY)"; return 0; }
  tail -n "$n" "$HISTORY"
  msg ""
  msg "Full output of each run: $LOG_DIR/<command>-ddmmyyyy.log"
}

act_logs() {
  local nodes n lines=${OPT[lines]:-200}
  mapfile -t nodes < <(target_nodes)
  for n in "${nodes[@]}"; do
    step "Logs on $n"
    ssh_check "$n"
    rq "$n" "journalctl -u corosync -u pacemaker -u pcsd -n $lines --no-pager"
  done
}

act_installautocomplete() {
  local src="" c nodes n
  if [ -n "${OPT[file]:-}" ]; then
    src=${OPT[file]}
  else
    for c in "$(dirname "$SELF")/$COMPLETION_NAME" "$CONF_DIR/$COMPLETION_NAME" "$PWD/$COMPLETION_NAME"; do
      [ -f "$c" ] && { src=$c; break; }
    done
  fi
  [ -n "$src" ] && [ -f "$src" ] || die "$COMPLETION_NAME not found. Use: $PROG -installautocomplete -file /path/to/$COMPLETION_NAME"
  bash -n "$src" || die "$src has syntax errors"
  msg "Using $src ($(sed -n 's/^#  Version *: *//p' "$src" | head -1))"
  mapfile -t nodes < <(target_nodes)
  for n in "${nodes[@]}"; do
    step "Tab completion on $n"
    ssh_check "$n"
    rsh "$n" "rpm -q bash-completion >/dev/null 2>&1 || dnf -y install bash-completion"
    rrun "$n" mkdir -p "$(dirname "$COMPLETION_DEST")" "$CONF_DIR"
    rcopy "$src" "$n" "$COMPLETION_DEST"
    rrun "$n" chmod 0644 "$COMPLETION_DEST"
    # keep a copy so -installautocomplete also works from the node later
    rcopy "$src" "$n" "$CONF_DIR/$COMPLETION_NAME"
  done
  msg ""
  msg "Done. Open a NEW bash shell, then type: $PROG -<Tab>"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
ACTIONS=" installprereq checkprereq validate onboard create destroy start stop enable disable
  status quorum property addnode removenode listnodes synchosts changeip standby unstandby maintenance
  addfence removefence listfence testfence bmcstatus
  iscsilogin iscsilogout listdisks mpathalias setuplocking setupstorage addjournal storagestatus removestorage
  addvm removevm startvm stopvm restartvm migratevm clearvm listvms vmstatus syncvm
  verify cleanup config backup restore report logs history installautocomplete help version "
VALUE_OPTS=" cluster nodes hapass ipaddr user pass agent params delay portal target chapuser
  chappass wwid alias device vg lv size mount fsname journals xml to prefer since lines file prefix cipher "
MULTI_OPTS=" nodes params "
FLAG_OPTS=" all yes force dryrun full nolanplus purge nomigrate nostart nosan wipe "

ORIG_ARGS=("$@")
declare -A OPT=()
ACTION=""
ARGS=()
current=""

for a in "$@"; do
  if [[ $a == -* && ! $a =~ ^-[0-9] ]]; then
    key=${a##-}; key=${key##-}; key=${key,,}
    case $key in sshtrust) key=onboard ;; node) key=nodes ;; h|"?") key=help ;; dry-run) key=dryrun ;; y) key=yes ;; esac
    [[ $key =~ ^[a-z]+$ ]] || die "Unknown switch: $a (see $PROG -help)"
    if [[ " $ACTIONS " =~ [[:space:]]$key[[:space:]] ]]; then
      [ -n "$ACTION" ] && die "Only one action per command (-$ACTION and -$key given)"
      ACTION=$key; current=ACTION
    elif [[ " $VALUE_OPTS " =~ [[:space:]]$key[[:space:]] ]]; then
      OPT[$key]=""; current=$key
    elif [[ " $FLAG_OPTS " =~ [[:space:]]$key[[:space:]] ]]; then
      OPT[$key]=1; current=ACTION
    else
      die "Unknown switch: $a (see $PROG -help)"
    fi
  else
    if [ "$current" = ACTION ]; then
      ARGS+=("$a")
    elif [ -n "$current" ]; then
      if [[ " $MULTI_OPTS " =~ [[:space:]]$current[[:space:]] ]]; then
        OPT[$current]+="${OPT[$current]:+ }$a"
      else
        OPT[$current]=$a
        current=ACTION      # further words are action arguments
      fi
    else
      die "Unexpected argument '$a' (start with an action, see $PROG -help)"
    fi
  fi
done

for k in $VALUE_OPTS; do
  if [[ -v OPT[$k] && -z ${OPT[$k]} ]]; then die "Switch -$k needs a value"; fi
done

flag() { [[ -n ${OPT[$1]:-} ]] && echo 1 || echo 0; }
ALL=$(flag all) YES=$(flag yes) FORCE=$(flag force) DRYRUN=$(flag dryrun) FULL=$(flag full)
NOLANPLUS=$(flag nolanplus) PURGE=$(flag purge) NOMIGRATE=$(flag nomigrate) NOSTART=$(flag nostart)
NOSAN=$(flag nosan) WIPE=$(flag wipe)
HAPASS=""
CL=""
NODES=()

[ -z "$ACTION" ] && { usage; exit 1; }
case $ACTION in
  help)    usage; exit 0 ;;
  version) echo "$PROG $VERSION"; exit 0 ;;
esac

[ "$(id -u)" -eq 0 ] || die "Run as root"
[ -n "${OPT[hapass]:-}" ] && warn "-hapass is visible in the process list; normally leave it out (cluster authorization is saved)"

# ---------------------------------------------------------------------------
# Logging: output -> $LOG_DIR/<command>-ddmmyyyy.log, one line -> history.log
# ---------------------------------------------------------------------------
masked_cmdline() {
  local a out="$PROG" mask=0
  for a in "${ORIG_ARGS[@]}"; do
    if ((mask)); then out+=" ****"; mask=0; continue; fi
    out+=" $(printf '%q' "$a")"
    case ${a,,} in -hapass|--hapass|-pass|--pass|-chappass|--chappass) mask=1 ;; esac
  done
  printf '%s' "$out"
}

log_finish() {
  local rc=$1 end dur
  end=$(date +%s%N)
  dur=$(( (end - START_NS) / 1000000 ))
  echo "=== $(date '+%Y-%m-%d %H:%M:%S') finished: exit=$rc duration=${dur}ms ==="
  printf '%s  %-10s %-8s %-6s exit=%-3s %7sms  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(hostname -s)" \
    "${SUDO_USER:-$(id -un)}" "$( ((DRYRUN)) && echo dryrun || echo live)" "$rc" "$dur" "$CMDLINE" \
    >> "$HISTORY" 2>/dev/null || true
  exec 1>&- 2>&-
  wait "$TEE_PID" 2>/dev/null || true
}

if [ "$ACTION" = history ]; then
  :   # viewing the history is not logged
elif mkdir -p "$LOG_DIR" 2>/dev/null && chmod 0750 "$LOG_DIR" 2>/dev/null; then
  LOGFILE="$LOG_DIR/${ACTION}-$(date +%d%m%Y).log"
  CMDLINE=$(masked_cmdline)
  START_NS=$(date +%s%N)
  touch "$LOGFILE" "$HISTORY" && chmod 0640 "$LOGFILE" "$HISTORY"
  exec > >(tee -a "$LOGFILE") 2>&1
  TEE_PID=$!
  echo ""
  echo "=== $(date '+%Y-%m-%d %H:%M:%S') $(hostname -s) user=${SUDO_USER:-$(id -un)}: $CMDLINE ($( ((DRYRUN)) && echo dry-run || echo live)) ==="
  trap 'log_finish $?' EXIT
else
  warn "Cannot write to $LOG_DIR - running without a log file"
fi

"act_$ACTION"
