# ---------------------------------------------------------------------------
usage() {
cat <<EOF
$PROG $VERSION - KVM high-availability cluster management for Fedora 42

USAGE
  $PROG -<action> [arguments] [options]

NODE PREPARATION
  -installprereq [node ...]          Install and configure all prerequisites
                                     (local node if none given; remote nodes
                                     over root SSH). Cluster authorization is
                                     generated on the first run and stored
                                     securely on every node
  -checkprereq   [node ...]          Verify prerequisites, report OK/FAIL
  -validate      [node ...] [-portal IP[:port]] [-nosan]   (default: all cluster nodes)
                                     Check required kernel modules (loaded or
                                     loadable for the running kernel), CPU
                                     virtualization, /dev/kvm, packages,
                                     commands and SAN storage: iSCSI portals
                                     reachable, sessions logged in, multipath
                                     LUNs and active paths; with several nodes
                                     also the same LUN on every node and unique
                                     initiator names. Read-only; exit 1 on FAIL
