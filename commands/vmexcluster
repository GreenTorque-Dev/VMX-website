act_maintenance() {
  need_args 1 "Usage: $PROG -maintenance on|off [-nodes n1 ...]"
  require_running
  local mode=${ARGS[0],,} nodes=()
  [ -n "${OPT[nodes]:-}" ] && read -ra nodes <<<"${OPT[nodes]}"
  case $mode in
    on)
      if ((${#nodes[@]})); then run pcs node maintenance "${nodes[@]}"
